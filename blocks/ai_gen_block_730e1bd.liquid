{% doc %}
  @prompt
    under the hero heading the ability to upload the logo where its two column, one image and the other text 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-text-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-logo-text-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  .ai-logo-text-image-column-{{ ai_gen_id }} {
    {% if block.settings.layout == 'image_left' %}
      order: 1;
    {% else %}
      order: 2;
    {% endif %}
  }

  .ai-logo-text-text-column-{{ ai_gen_id }} {
    {% if block.settings.layout == 'image_left' %}
      order: 2;
    {% else %}
      order: 1;
    {% endif %}
  }

  .ai-logo-text-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    {% if block.settings.layout == 'image_left' %}
      margin-left: 0;
      margin-right: auto;
    {% else %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
  }

  .ai-logo-text-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-logo-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 200px;
  }

  .ai-logo-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-logo-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-logo-text-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-logo-text-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
  }

  .ai-logo-text-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-text-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-logo-text-image-column-{{ ai_gen_id }},
    .ai-logo-text-text-column-{{ ai_gen_id }} {
      order: unset;
    }

    .ai-logo-text-image-wrapper-{{ ai_gen_id }} {
      margin-left: auto;
      margin-right: auto;
    }

    .ai-logo-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-logo-text-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<logo-text-block-{{ ai_gen_id }}
  class="ai-logo-text-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-logo-text-container-{{ ai_gen_id }}">
    <div class="ai-logo-text-image-column-{{ ai_gen_id }}">
      <div class="ai-logo-text-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.logo_image %}
          <img
            src="{{ block.settings.logo_image | image_url: width: 800 }}"
            alt="{{ block.settings.logo_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.logo_image.width }}"
            height="{{ block.settings.logo_image.height }}"
            class="ai-logo-text-image-{{ ai_gen_id }}"
            style="border-radius: {{ block.settings.image_border_radius }}px;"
          >
        {% else %}
          <div class="ai-logo-text-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-logo-text-empty-state-{{ ai_gen_id }}">
              Upload your logo
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-logo-text-text-column-{{ ai_gen_id }}">
      <div class="ai-logo-text-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-logo-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-logo-text-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</logo-text-block-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoTextBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('logo-text-block-{{ ai_gen_id }}', LogoTextBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Logo and text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image_left",
          "label": "Image left, text right"
        },
        {
          "value": "image_right",
          "label": "Image right, text left"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Logo image"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Maximum width",
      "min": 100,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our Mission"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Share your story, mission, or values with your customers. This two-column layout helps you combine your logo with compelling text content.</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Spacing below heading",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#2b5275"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2b5275"
    }
  ],
  "presets": [
    {
      "name": "Logo and text"
    }
  ]
}
{% endschema %}