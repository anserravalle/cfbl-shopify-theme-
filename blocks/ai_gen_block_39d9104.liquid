{% doc %}
  @prompt
    Create a hero banner section for the CFBL Institute landing page that is fully customizable in the Shopify theme editor.
    
    The section should include:
    
    editable desktop background image
    editable mobile background image
    editable eyebrow text
    editable main heading
    editable subheading or body text
    editable primary button label
    editable primary button link
    editable secondary button label
    editable secondary button link
    editable text alignment
    editable content position
    editable overlay color
    editable overlay opacity
    editable text color
    editable section height
    editable top and bottom padding
    editable border radius or square corners option
    
    Design direction:
    clean, elevated, warm, professional, clinically grounded, and visually aligned with a psychologist-led educational institute. The style should feel refined and thoughtful, not trendy or corporate.
    
    Layout:
    full-width hero banner with text content layered over the image. Content should sit inside a constrained content container for readability. Include enough contrast between text and image for accessibility.
    
    Behavior:
    all text, buttons, images, overlay settings, spacing, and alignment must remain editable in the Shopify theme editor. Do not hardcode the text or links into the section markup. Build this as a reusable section, not a static image with embedded text.
    
    Recommended default content:
    Eyebrow text: CFBL Institute
    Heading: Training, education, and professional development
    Subheading: Thoughtful, trauma-informed, and ecologically grounded learning for clinicians, helping professionals, and community members.
    Primary button: Explore Offerings
    Secondary button: Contact the Institute
    
    Optional advanced settings:
    
    enable or disable second button
    enable or disable overlay
    separate desktop and mobile text alignment
    max content width control
    button style selector
    image focal point control if available
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height_mobile }}px;
    display: flex;
    align-items: {{ block.settings.content_position }};
    justify-content: center;
    overflow: hidden;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-hero-banner-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-banner-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_focal_point }};
  }

  .ai-hero-banner-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-banner-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-hero-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
    {% unless block.settings.enable_overlay %}
      display: none;
    {% endunless %}
  }

  .ai-hero-banner-content-wrapper-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: {{ block.settings.content_max_width }}px;
    padding-left: 24px;
    padding-right: 24px;
    text-align: {{ block.settings.text_alignment_mobile }};
  }

  .ai-hero-banner-eyebrow-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
    opacity: 0.9;
  }

  .ai-hero-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 36px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 20px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
  }

  .ai-hero-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 18px;
    line-height: 1.6;
    margin: 0 0 32px 0;
    opacity: 0.95;
  }

  .ai-hero-banner-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: {{ block.settings.text_alignment_mobile }};
  }

  .ai-hero-banner-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .ai-hero-banner-button-primary-{{ ai_gen_id }} {
    {% if block.settings.button_style == 'fill' %}
      background-color: {{ block.settings.primary_button_background }};
      color: {{ block.settings.primary_button_text }};
      border-color: {{ block.settings.primary_button_background }};
    {% else %}
      background-color: transparent;
      color: {{ block.settings.primary_button_background }};
      border-color: {{ block.settings.primary_button_background }};
    {% endif %}
  }

  .ai-hero-banner-button-primary-{{ ai_gen_id }}:hover {
    {% if block.settings.button_style == 'fill' %}
      background-color: {{ block.settings.primary_button_hover_background }};
      border-color: {{ block.settings.primary_button_hover_background }};
    {% else %}
      background-color: {{ block.settings.primary_button_background }};
      color: {{ block.settings.primary_button_text }};
    {% endif %}
  }

  .ai-hero-banner-button-secondary-{{ ai_gen_id }} {
    {% if block.settings.button_style == 'fill' %}
      background-color: {{ block.settings.secondary_button_background }};
      color: {{ block.settings.secondary_button_text }};
      border-color: {{ block.settings.secondary_button_background }};
    {% else %}
      background-color: transparent;
      color: {{ block.settings.secondary_button_background }};
      border-color: {{ block.settings.secondary_button_background }};
    {% endif %}
  }

  .ai-hero-banner-button-secondary-{{ ai_gen_id }}:hover {
    {% if block.settings.button_style == 'fill' %}
      background-color: {{ block.settings.secondary_button_hover_background }};
      border-color: {{ block.settings.secondary_button_hover_background }};
    {% else %}
      background-color: {{ block.settings.secondary_button_background }};
      color: {{ block.settings.secondary_button_text }};
    {% endif %}
  }

  .ai-hero-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    z-index: 4;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height_desktop }}px;
    }

    .ai-hero-banner-content-wrapper-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_alignment_desktop }};
      padding-left: 40px;
      padding-right: 40px;
    }

    .ai-hero-banner-eyebrow-{{ ai_gen_id }} {
      font-size: 16px;
      margin-bottom: 20px;
    }

    .ai-hero-banner-heading-{{ ai_gen_id }} {
      font-size: 56px;
      margin-bottom: 24px;
    }

    .ai-hero-banner-subheading-{{ ai_gen_id }} {
      font-size: 20px;
      margin-bottom: 40px;
    }

    .ai-hero-banner-buttons-{{ ai_gen_id }} {
      justify-content: {{ block.settings.text_alignment_desktop }};
    }

    .ai-hero-banner-button-{{ ai_gen_id }} {
      padding: 16px 40px;
      font-size: 17px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-hero-banner-heading-{{ ai_gen_id }} {
      font-size: 64px;
    }

    .ai-hero-banner-subheading-{{ ai_gen_id }} {
      font-size: 22px;
    }
  }
{% endstyle %}

<div class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-banner-background-{{ ai_gen_id }}">
    {% if block.settings.desktop_image or block.settings.mobile_image %}
      <picture>
        {% if block.settings.mobile_image %}
          <source
            media="(max-width: 749px)"
            srcset="{{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                    {{ block.settings.mobile_image | image_url: width: 1500 }} 1500w"
          >
        {% endif %}
        {% if block.settings.desktop_image %}
          <img
            src="{{ block.settings.desktop_image | image_url: width: 1600 }}"
            srcset="{{ block.settings.desktop_image | image_url: width: 1600 }} 1600w,
                    {{ block.settings.desktop_image | image_url: width: 2000 }} 2000w,
                    {{ block.settings.desktop_image | image_url: width: 3000 }} 3000w"
            alt="{{ block.settings.desktop_image.alt | escape }}"
            loading="eager"
            width="{{ block.settings.desktop_image.width }}"
            height="{{ block.settings.desktop_image.height }}"
          >
        {% endif %}
      </picture>
    {% else %}
      <div class="ai-hero-banner-background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
      <div class="ai-hero-banner-empty-state-{{ ai_gen_id }}">
        Add a desktop and mobile background image
      </div>
    {% endif %}
  </div>

  <div class="ai-hero-banner-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-hero-banner-content-wrapper-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <div class="ai-hero-banner-eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow_text }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h1 class="ai-hero-banner-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-hero-banner-subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    {% if block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank %}
      <div class="ai-hero-banner-buttons-{{ ai_gen_id }}">
        {% if block.settings.primary_button_label != blank %}
          <a
            href="{{ block.settings.primary_button_link }}"
            class="ai-hero-banner-button-{{ ai_gen_id }} ai-hero-banner-button-primary-{{ ai_gen_id }}"
          >
            {{ block.settings.primary_button_label }}
          </a>
        {% endif %}

        {% if block.settings.enable_secondary_button and block.settings.secondary_button_label != blank %}
          <a
            href="{{ block.settings.secondary_button_link }}"
            class="ai-hero-banner-button-{{ ai_gen_id }} ai-hero-banner-button-secondary-{{ ai_gen_id }}"
          >
            {{ block.settings.secondary_button_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CFBL Institute hero",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "select",
      "id": "image_focal_point",
      "label": "Image focal point",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "CFBL Institute"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Training, education, and professional development"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Thoughtful, trauma-informed, and ecologically grounded learning for clinicians, helping professionals, and community members.</p>"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Label",
      "default": "Explore Offerings"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "checkbox",
      "id": "enable_secondary_button",
      "label": "Enable secondary button",
      "default": true
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Label",
      "default": "Contact the Institute"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment_desktop",
      "label": "Text alignment (desktop)",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text alignment (mobile)",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "fill", "label": "Fill" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "primary_button_background",
      "label": "Primary button background",
      "default": "#2b5275"
    },
    {
      "type": "color",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "#eed9c5"
    },
    {
      "type": "color",
      "id": "primary_button_hover_background",
      "label": "Primary button hover background",
      "default": "#1e3a52"
    },
    {
      "type": "color",
      "id": "secondary_button_background",
      "label": "Secondary button background",
      "default": "#4e9484"
    },
    {
      "type": "color",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "#eed9c5"
    },
    {
      "type": "color",
      "id": "secondary_button_hover_background",
      "label": "Secondary button hover background",
      "default": "#3d7a6d"
    },
    {
      "type": "header",
      "content": "Section sizing"
    },
    {
      "type": "range",
      "id": "section_height_desktop",
      "label": "Section height (desktop)",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 650
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Section height (mobile)",
      "min": 300,
      "max": 700,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "itc_berkeley_old_style_n4"
    }
  ],
  "presets": [
    {
      "name": "CFBL Institute hero"
    }
  ]
}
{% endschema %}
