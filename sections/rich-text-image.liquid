<section class="cfbl-rich-text-image" style="background-color: {{ section.settings.background_color }};">
  <div class="cfbl-rich-text-image__inner">

    {% if section.settings.heading != blank %}
      <h2
        class="cfbl-rich-text-image__heading"
        style="
          color: {{ section.settings.heading_color }};
          font-size: {{ section.settings.heading_size }}px;
        "
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div
        class="cfbl-rich-text-image__text"
        style="
          color: {{ section.settings.text_color }};
          font-size: {{ section.settings.text_size }}px;
        "
      >
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.image != blank %}
      <div class="cfbl-rich-text-image__image-wrap">
        <img
          class="cfbl-rich-text-image__image"
          src="{{ section.settings.image | image_url: width: 1800 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
        >
      </div>
    {% endif %}

  </div>
</section>

<style>
  .cfbl-rich-text-image {
    padding: 56px 20px;
  }

  .cfbl-rich-text-image__inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .cfbl-rich-text-image__heading {
    margin: 0 0 18px;
    line-height: 1.2;
    font-weight: 600;
  }

  .cfbl-rich-text-image__text {
    max-width: 850px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .cfbl-rich-text-image__text p {
    margin: 0 0 16px;
  }

  .cfbl-rich-text-image__text p:last-child {
    margin-bottom: 0;
  }

  .cfbl-rich-text-image__image-wrap {
    margin-top: 34px;
  }

  .cfbl-rich-text-image__image {
    width: 100%;
    max-width: 950px;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
    display: block;
    margin: 0 auto;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .cfbl-rich-text-image {
      padding: 42px 18px;
    }

    .cfbl-rich-text-image__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.78) !important;
    }

    .cfbl-rich-text-image__text {
      font-size: calc({{ section.settings.text_size }}px * 0.92) !important;
    }

    .cfbl-rich-text-image__image-wrap {
      margin-top: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "Rich text with image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Care with clinical depth and human understanding"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>At Center for Balanced Living, our services are grounded in clinical expertise, trauma-informed care, and respect for the whole person.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image below text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F6F1E8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2E332F"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 60,
      "step": 1,
      "default": 36
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2E332F"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Rich text with image"
    }
  ]
}
{% endschema %}