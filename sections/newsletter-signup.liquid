{% liquid
  assign bg = section.settings.background | default: 'navy-dark'

  case bg
    when 'sand'
      assign bg_color = 'var(--cfbl-sand-light)'
      assign brand_class = 'brand-cfbl'
    when 'cream'
      assign bg_color = 'var(--inst-cream)'
      assign brand_class = 'brand-institute'
    when 'bone'
      assign bg_color = 'var(--musa-bone)'
      assign brand_class = 'brand-musa'
    when 'navy-dark'
      assign bg_color = '#1A3347'
      assign brand_class = 'brand-cfbl'
    else
      assign bg_color = 'var(--cfbl-sand-light)'
      assign brand_class = 'brand-cfbl'
  endcase
%}

<style>
  #shopify-section-{{ section.id }} .newsletter-signup {
    background: {{ bg_color }};
    padding: var(--space-9) 0;
  }

  {%- if bg == 'navy-dark' -%}
  #shopify-section-{{ section.id }} .newsletter-signup {
    color: var(--cfbl-sand-pale);
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .newsletter-signup__inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .newsletter-signup__heading {
    margin: 0 0 var(--space-3);
  }

  {%- if bg == 'navy-dark' -%}
  #shopify-section-{{ section.id }} .newsletter-signup__heading {
    color: #fff;
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .newsletter-signup__subheading {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 var(--space-6);
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .newsletter-signup__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  #shopify-section-{{ section.id }} .newsletter-signup__row {
    display: flex;
    gap: var(--space-2);
    width: 100%;
    max-width: 440px;
  }

  #shopify-section-{{ section.id }} .newsletter-signup__input {
    flex: 1;
    padding: 0.75rem var(--space-4);
    border: 1px solid var(--cfbl-rule);
    border-radius: var(--radius-sm);
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    background: #fff;
    color: var(--cfbl-ink);
    outline: none;
    min-width: 0;
    transition: border-color var(--dur-fast) var(--ease);
  }

  {%- if brand_class == 'brand-institute' -%}
  #shopify-section-{{ section.id }} .newsletter-signup__input {
    border-color: var(--inst-rule);
    font-family: var(--inst-font-body);
    background: var(--inst-paper);
  }
  {%- elsif brand_class == 'brand-musa' -%}
  #shopify-section-{{ section.id }} .newsletter-signup__input {
    border-color: var(--musa-rule);
    font-family: var(--musa-font-body);
    background: var(--musa-parchment);
  }
  {%- endif -%}

  {%- if bg == 'navy-dark' -%}
  #shopify-section-{{ section.id }} .newsletter-signup__input {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.2);
    color: #fff;
  }
  #shopify-section-{{ section.id }} .newsletter-signup__input::placeholder {
    color: rgba(255,255,255,0.45);
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .newsletter-signup__input:focus {
    border-color: var(--cfbl-sky-blue);
  }

  #shopify-section-{{ section.id }} .newsletter-signup__note {
    font-size: 0.8125rem;
    opacity: 0.6;
    margin: 0;
    line-height: 1.5;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

<section class="newsletter-signup {{ brand_class }}" aria-labelledby="nl-heading-{{ section.id }}">
  <div class="newsletter-signup__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter-signup__heading" id="nl-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="newsletter-signup__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {% form 'customer', id: 'newsletter-form-{{ section.id }}', class: 'newsletter-signup__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- comment -%} Honeypot anti-spam field {%- endcomment -%}
      <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
        <label for="nl-hp-{{ section.id }}">Leave this field empty</label>
        <input
          type="text"
          id="nl-hp-{{ section.id }}"
          name="contact[website]"
          tabindex="-1"
          autocomplete="off"
        >
      </div>

      <div class="newsletter-signup__row">
        <label for="nl-email-{{ section.id }}" class="visually-hidden">
          Email address
        </label>
        <input
          type="email"
          id="nl-email-{{ section.id }}"
          name="contact[email]"
          class="newsletter-signup__input"
          placeholder="you@example.com"
          required
          autocomplete="email"
        >
        <button type="submit" class="btn btn-primary">
          {{ section.settings.cta_label | default: 'Subscribe' | escape }}
        </button>
      </div>

      <p class="newsletter-signup__note">No marketing. New essays and updates only. Unsubscribe at any time.</p>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New essays and updates"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "sand",
          "label": "Sand (CFBL)"
        },
        {
          "value": "cream",
          "label": "Cream (Institute)"
        },
        {
          "value": "bone",
          "label": "Bone (MUSA)"
        },
        {
          "value": "navy-dark",
          "label": "Deep Navy (dark)"
        }
      ],
      "default": "sand"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading & text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left (default)"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium (default)"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup",
      "settings": {
        "heading": "New essays and updates",
        "cta_label": "Subscribe",
        "background": "sand"
      }
    }
  ]
}
{% endschema %}