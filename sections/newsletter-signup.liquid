{% liquid
  assign bg = section.settings.background | default: 'sand'

  case bg
    when 'sand'
      assign bg_color = 'var(--cfbl-sand-light)'
      assign brand_class = 'brand-cfbl'
    when 'cream'
      assign bg_color = 'var(--inst-cream)'
      assign brand_class = 'brand-institute'
    when 'bone'
      assign bg_color = 'var(--musa-bone)'
      assign brand_class = 'brand-musa'
    when 'navy-dark'
      assign bg_color = '#1A3347'
      assign brand_class = 'brand-cfbl'
    else
      assign bg_color = 'var(--cfbl-sand-light)'
      assign brand_class = 'brand-cfbl'
  endcase
%}

<style>
  #shopify-section-{{ section.id }} .newsletter-signup {
    background: {{ bg_color }};
    padding: var(--space-9) 0;
  }

  {%- if bg == 'navy-dark' -%}
  #shopify-section-{{ section.id }} .newsletter-signup {
    color: var(--cfbl-sand-pale);
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .newsletter-signup__inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .newsletter-signup__heading {
    margin: 0 0 var(--space-3);
  }

  {%- if bg == 'navy-dark' -%}
  #shopify-section-{{ section.id }} .newsletter-signup__heading {
    color: #fff;
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .newsletter-signup__subheading {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 var(--space-6);
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .newsletter-signup__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  #shopify-section-{{ section.id }} .newsletter-signup__row {
    display: flex;
    gap: var(--space-2);
    width: 100%;
    max-width: 440px;
  }

  #shopify-section-{{ section.id }} .newsletter-signup__input {
    flex: 1;
    padding: 0.75rem var(--space-4);
    border: 1px solid var(--cfbl-rule);
    border-radius: var(--radius-sm);
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    background: #fff;
    color: var(--cfbl-ink);
    outline: none;
    min-width: 0;
    transition: border-color var(--dur-fast) var(--ease);
  }

  {%- if brand_class == 'brand-institute' -%}
  #shopify-section-{{ section.id }} .newsletter-signup__input {
    border-color: var(--inst-rule);
    font-family: var(--inst-font-body);
    background: var(--inst-paper);
  }
  {%- elsif brand_class == 'brand-musa' -%}
  #shopify-section-{{ section.id }} .newsletter-signup__input {
    border-color: var(--musa-rule);
    font-family: var(--musa-font-body);
    background: var(--musa-parchment);
  }
  {%- endif -%}

  {%- if bg == 'navy-dark' -%}
  #shopify-section-{{ section.id }} .newsletter-signup__input {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.2);
    color: #fff;
  }
  #shopify-section-{{ section.id }} .newsletter-signup__input::placeholder {
    color: rgba(255,255,255,0.45);
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .newsletter-signup__input:focus {
    border-color: var(--cfbl-sky-blue);
  }

  #shopify-section-{{ section.id }} .newsletter-signup__note {
    font-size: 0.8125rem;
    opacity: 0.6;
    margin: 0;
    line-height: 1.5;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<section class="newsletter-signup {{ brand_class }}" aria-labelledby="nl-heading-{{ section.id }}">
  <div class="newsletter-signup__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter-signup__heading" id="nl-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="newsletter-signup__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {% form 'customer', id: 'newsletter-form-{{ section.id }}', class: 'newsletter-signup__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- comment -%} Honeypot anti-spam field {%- endcomment -%}
      <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
        <label for="nl-hp-{{ section.id }}">Leave this field empty</label>
        <input
          type="text"
          id="nl-hp-{{ section.id }}"
          name="contact[website]"
          tabindex="-1"
          autocomplete="off"
        >
      </div>

      <div class="newsletter-signup__row">
        <label for="nl-email-{{ section.id }}" class="visually-hidden">
          Email address
        </label>
        <input
          type="email"
          id="nl-email-{{ section.id }}"
          name="contact[email]"
          class="newsletter-signup__input"
          placeholder="you@example.com"
          required
          autocomplete="email"
        >
        <button type="submit" class="btn btn-primary">
          {{ section.settings.cta_label | default: 'Subscribe' | escape }}
        </button>
      </div>

      <p class="newsletter-signup__note">No marketing. New essays and updates only. Unsubscribe at any time.</p>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New essays and updates"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "sand", "label": "Sand (CFBL)" },
        { "value": "cream", "label": "Cream (Institute)" },
        { "value": "bone", "label": "Bone (MUSA)" },
        { "value": "navy-dark", "label": "Deep Navy (dark)" }
      ],
      "default": "sand"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup",
      "settings": {
        "heading": "New essays and updates",
        "cta_label": "Subscribe",
        "background": "sand"
      }
    }
  ]
}
{% endschema %}
