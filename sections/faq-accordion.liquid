<style>
  #shopify-section-{{ section.id }} .faq-accordion {
    background: var(--cfbl-sand);
    padding: var(--space-9) 0;
  }

  #shopify-section-{{ section.id }} .faq-accordion__inner {
    max-width: var(--container-text);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  #shopify-section-{{ section.id }} .faq-accordion__heading {
    font-family: var(--cfbl-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0 0 var(--space-8);
  }

  #shopify-section-{{ section.id }} .faq-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .faq-item {
    border-top: 1px solid var(--cfbl-rule);
  }

  #shopify-section-{{ section.id }} .faq-item:last-child {
    border-bottom: 1px solid var(--cfbl-rule);
  }

  #shopify-section-{{ section.id }} .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
    background: none;
    border: none;
    padding: var(--space-5) 0;
    text-align: left;
    cursor: pointer;
    font-family: var(--cfbl-font-body);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .faq-question:hover {
    color: var(--cfbl-sky-blue);
  }

  #shopify-section-{{ section.id }} .faq-question:focus-visible {
    outline: 2px solid var(--cfbl-deep-navy);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  #shopify-section-{{ section.id }} .faq-question__icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cfbl-sky-blue);
    transition: transform var(--dur-base) var(--ease);
  }

  #shopify-section-{{ section.id }} .faq-question[aria-expanded="true"] .faq-question__icon {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .faq-question__icon svg {
    width: 20px;
    height: 20px;
  }

  #shopify-section-{{ section.id }} .faq-answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height var(--dur-slow) var(--ease);
  }

  #shopify-section-{{ section.id }} .faq-answer.is-open {
    max-height: 800px;
  }

  #shopify-section-{{ section.id }} .faq-answer__inner {
    padding: 0 var(--space-8) var(--space-6) 0;
    font-family: var(--cfbl-font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--cfbl-ink);
  }

  #shopify-section-{{ section.id }} .faq-answer__inner p {
    margin: 0 0 var(--space-4);
  }

  #shopify-section-{{ section.id }} .faq-answer__inner p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .faq-answer__inner a {
    color: var(--cfbl-sky-blue);
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .faq-answer__inner ul,
  #shopify-section-{{ section.id }} .faq-answer__inner ol {
    padding-left: var(--space-5);
    margin: var(--space-3) 0;
  }

  #shopify-section-{{ section.id }} .faq-answer__inner li {
    margin-bottom: var(--space-2);
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

<section class="faq-accordion brand-cfbl" aria-labelledby="faq-heading-{{ section.id }}">
  <div class="faq-accordion__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-accordion__heading" id="faq-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="faq-list" role="list">
        {%- for block in section.blocks -%}
          <li class="faq-item" {{ block.shopify_attributes }}>
            <button
              class="faq-question"
              type="button"
              aria-expanded="false"
              aria-controls="faq-answer-{{ section.id }}-{{ forloop.index }}"
              id="faq-btn-{{ section.id }}-{{ forloop.index }}"
            >
              <span>{{ block.settings.question | escape }}</span>
              <span class="faq-question__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </button>
            <div
              class="faq-answer"
              id="faq-answer-{{ section.id }}-{{ forloop.index }}"
              role="region"
              aria-labelledby="faq-btn-{{ section.id }}-{{ forloop.index }}"
              hidden
            >
              <div class="faq-answer__inner">
                {{ block.settings.answer }}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var section = document.getElementById('shopify-section-' + sectionId);
    if (!section) return;

    var buttons = section.querySelectorAll('.faq-question');

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var expanded = this.getAttribute('aria-expanded') === 'true';
        var panelId = this.getAttribute('aria-controls');
        var panel = document.getElementById(panelId);
        if (!panel) return;

        if (expanded) {
          // Close
          this.setAttribute('aria-expanded', 'false');
          panel.classList.remove('is-open');
          // Restore hidden after transition
          var self = panel;
          panel.addEventListener('transitionend', function handler() {
            if (!self.classList.contains('is-open')) {
              self.setAttribute('hidden', '');
            }
            self.removeEventListener('transitionend', handler);
          });
        } else {
          // Open
          panel.removeAttribute('hidden');
          // Force reflow so transition fires
          panel.getBoundingClientRect();
          panel.classList.add('is-open');
          this.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Keyboard: Escape closes current open item
    section.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var btn = document.activeElement;
        if (btn && btn.classList.contains('faq-question')) {
          if (btn.getAttribute('aria-expanded') === 'true') {
            btn.click();
            btn.focus();
          }
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Frequently Asked Questions"
