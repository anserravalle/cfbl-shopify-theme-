          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you accept insurance?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Do you accept insurance?",
            "answer": "<p>We are in-network with several major insurers. Please contact us directly and we will verify your specific coverage before your first appointment.</p>"
