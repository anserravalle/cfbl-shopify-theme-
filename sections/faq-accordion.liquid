        },
        {
          "value": "md",
          "label": "Medium (default)"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "limit": 20,
      "settings": [
