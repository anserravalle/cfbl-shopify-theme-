<style>
  .site-footer {
    background: #2A2520;
    color: #C8BEB4;
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    padding: var(--space-9) 0 0;
  }

  .site-footer a {
    color: #C8BEB4;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .site-footer a:hover {
    color: #fff;
  }

  .site-footer__cols {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-8);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .site-footer__col-label {
    font-family: var(--cfbl-font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(200, 190, 180, 0.55);
    margin: 0 0 var(--space-2);
    font-weight: 500;
  }

  .site-footer__col-title {
    font-family: var(--cfbl-font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    color: #fff;
    margin: 0 0 var(--space-4);
    letter-spacing: 0.01em;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__col ul li a {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .site-footer__contact-line {
    font-size: 0.9375rem;
    color: rgba(200, 190, 180, 0.75);
    margin: 0 0 var(--space-2);
    line-height: 1.5;
  }

  .site-footer__contact-line a {
    color: rgba(200, 190, 180, 0.75);
  }

  .site-footer__contact-line a:hover {
    color: #fff;
  }

  /* Newsletter */
  .site-footer__newsletter {
    margin-top: var(--space-6);
    border-top: 1px solid rgba(200, 190, 180, 0.12);
    padding-top: var(--space-6);
  }

  .site-footer__newsletter-heading {
    font-family: var(--cfbl-font-display);
    font-size: 1rem;
    font-weight: 500;
    color: #fff;
    margin: 0 0 var(--space-3);
    letter-spacing: 0.01em;
  }

  .site-footer__nl-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__nl-row {
    display: flex;
    gap: var(--space-2);
  }

  .site-footer__nl-row input[type="email"] {
    flex: 1;
    padding: 0.625rem var(--space-3);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(200, 190, 180, 0.25);
    border-radius: var(--radius-sm);
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    color: #fff;
    outline: none;
    transition: border-color var(--dur-fast) var(--ease);
    min-width: 0;
  }

  .site-footer__nl-row input[type="email"]::placeholder {
    color: rgba(200, 190, 180, 0.45);
  }

  .site-footer__nl-row input[type="email"]:focus {
    border-color: rgba(200, 190, 180, 0.6);
  }

  .site-footer__nl-row button {
    padding: 0.625rem var(--space-4);
    background: var(--cfbl-deep-navy);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--cfbl-font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--dur-base) var(--ease);
  }

  .site-footer__nl-row button:hover {
    background: #1F4060;
  }

  /* Social links */
  .site-footer__social {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .site-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(200, 190, 180, 0.25);
    border-radius: var(--radius-sm);
    color: rgba(200, 190, 180, 0.7);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .site-footer__social-link:hover {
    border-color: rgba(200, 190, 180, 0.6);
    color: #fff;
  }

  .site-footer__social-link svg {
    width: 16px;
    height: 16px;
  }

  /* Bottom row */
  .site-footer__bottom {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    border-top: 1px solid rgba(200, 190, 180, 0.12);
  }

  .site-footer__copyright {
    font-size: 0.8125rem;
    color: rgba(200, 190, 180, 0.5);
    margin: 0;
  }

  .site-footer__utility-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .site-footer__utility-links a {
    font-size: 0.8125rem;
    color: rgba(200, 190, 180, 0.5);
  }

  .site-footer__utility-links a:hover {
    color: rgba(200, 190, 180, 0.9);
  }

  @media (max-width: 900px) {
    .site-footer__cols {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 600px) {
    .site-footer__cols {
      grid-template-columns: 1fr;
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>

<footer class="site-footer" role="contentinfo">
  <div class="site-footer__cols">

    {%- comment -%} Column 1: CFBL {%- endcomment -%}
    <div class="site-footer__col">
      <p class="site-footer__col-label">Clinical Practice</p>
      <h2 class="site-footer__col-title">Center for Balanced Living</h2>
      {%- if linklists[section.settings.cfbl_links].links != blank -%}
        <ul role="list">
          {%- for link in linklists[section.settings.cfbl_links].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.address != blank -%}
        <p class="site-footer__contact-line">{{ section.settings.address | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <p class="site-footer__contact-line">
          <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.phone }}</a>
        </p>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <p class="site-footer__contact-line">
          <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} Column 2: CFBL Institute {%- endcomment -%}
    <div class="site-footer__col">
      <p class="site-footer__col-label">Continuing Education</p>
      <h2 class="site-footer__col-title">CFBL Institute</h2>
      {%- if linklists[section.settings.institute_links].links != blank -%}
        <ul role="list">
          {%- for link in linklists[section.settings.institute_links].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} Column 3: MUSA {%- endcomment -%}
    <div class="site-footer__col">
      <p class="site-footer__col-label">Essays &amp; Books</p>
      <h2 class="site-footer__col-title">MUSA</h2>
      {%- if linklists[section.settings.musa_links].links != blank -%}
        <ul role="list">
          {%- for link in linklists[section.settings.musa_links].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} Social links {%- endcomment -%}
      <div class="site-footer__social">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" class="site-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.facebook_url != blank -%}
          <a href="{{ section.settings.facebook_url }}" class="site-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.linkedin_url != blank -%}
          <a href="{{ section.settings.linkedin_url }}" class="site-footer__social-link" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Newsletter {%- endcomment -%}
      {%- if section.settings.show_newsletter -%}
        <div class="site-footer__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h3 class="site-footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h3>
          {%- endif -%}
          {% form 'customer', id: 'footer-newsletter-form' %}
            <div class="site-footer__nl-form">
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- comment -%} Honeypot {%- endcomment -%}
              <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
                <label for="footer-nl-hp">Leave this empty</label>
                <input type="text" id="footer-nl-hp" name="contact[website]" tabindex="-1" autocomplete="off">
              </div>
              <div class="site-footer__nl-row">
                <label for="footer-nl-email" class="visually-hidden">Email address</label>
                <input
                  type="email"
                  id="footer-nl-email"
                  name="contact[email]"
                  placeholder="you@example.com"
                  required
                  autocomplete="email"
                >
                <button type="submit">Subscribe</button>
              </div>
            </div>
          {% endform %}
        </div>
      {%- endif -%}
    </div>

  </div>

  {%- comment -%} Bottom utility row {%- endcomment -%}
  <div class="site-footer__bottom">
    <p class="site-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} Center for Balanced Living. All rights reserved.
    </p>
    <ul class="site-footer__utility-links" role="list">
      <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
      <li><a href="/pages/terms">Terms</a></li>
      <li><a href="/pages/accessibility">Accessibility Statement</a></li>
      <li><a href="/account/login">Client Portal</a></li>
    </ul>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Navigation columns"
    },
    {
      "type": "link_list",
      "id": "cfbl_links",
      "label": "CFBL links"
    },
    {
      "type": "link_list",
      "id": "institute_links",
      "label": "Institute links"
    },
    {
      "type": "link_list",
      "id": "musa_links",
      "label": "MUSA links",
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "New essays and updates"
    }
  ]
}
{% endschema %}
