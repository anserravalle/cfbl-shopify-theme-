<style>
  #shopify-section-{{ section.id }} .resource-grid-section {
    background: var(--inst-cream);
    padding: var(--space-9) 0;
  }

  #shopify-section-{{ section.id }} .resource-grid-section__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  #shopify-section-{{ section.id }} .resource-grid-section__head {
    max-width: 560px;
    margin: 0 0 var(--space-8);
    border-top: 2px solid var(--inst-forest);
    padding-top: var(--space-5);
  }

  #shopify-section-{{ section.id }} .resource-grid-section__heading {
    font-family: var(--inst-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    color: var(--inst-forest);
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .resource-grid-section__subheading {
    font-family: var(--inst-font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--inst-ink);
    margin: var(--space-4) 0 0;
  }

  #shopify-section-{{ section.id }} .resource-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  #shopify-section-{{ section.id }} .resource-card {
    background: var(--inst-paper);
    border-radius: var(--radius-sm);
    border: 1px solid var(--inst-rule);
    border-top: 2px solid var(--inst-forest);
    padding: var(--space-5) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  #shopify-section-{{ section.id }} .resource-card__type-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--inst-font-utility);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--inst-forest);
    border: 1px solid var(--inst-rule);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    align-self: flex-start;
  }

  #shopify-section-{{ section.id }} .resource-card__type-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .resource-card__title {
    font-family: var(--inst-font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--inst-forest);
    letter-spacing: 0.01em;
    line-height: 1.25;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .resource-card__description {
    font-family: var(--inst-font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--inst-ink);
    margin: 0;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .resource-card__link {
    font-family: var(--inst-font-utility);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--inst-forest);
    text-decoration: underline;
    text-underline-offset: 3px;
    align-self: flex-start;
    margin-top: var(--space-2);
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .resource-card__link:hover {
    color: var(--inst-ink);
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .resource-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    #shopify-section-{{ section.id }} .resource-grid {
      grid-template-columns: 1fr;
    }
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

<section class="resource-grid-section brand-institute" aria-labelledby="res-heading-{{ section.id }}">
  <div class="resource-grid-section__inner">
    <div class="resource-grid-section__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="resource-grid-section__heading" id="res-heading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="resource-grid-section__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="resource-grid">
        {%- for block in section.blocks -%}
          {%- assign rtype = block.settings.resource_type | default: 'Link' -%}
          <article class="resource-card" {{ block.shopify_attributes }}>

            <span class="resource-card__type-badge" aria-label="{{ rtype }} resource">
              {%- if rtype == 'PDF' -%}
                <svg class="resource-card__type-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
              {%- elsif rtype == 'Video' -%}
                <svg class="resource-card__type-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
              {%- elsif rtype == 'Article' -%}
                <svg class="resource-card__type-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
              {%- else -%}
                <svg class="resource-card__type-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>
              {%- endif -%}
              {{ rtype }}
            </span>

            {%- if block.settings.title != blank -%}
              <h3 class="resource-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="resource-card__description">{{ block.settings.description }}</p>
            {%- endif -%}

            {%- if block.settings.url != blank -%}
              <a
                href="{{ block.settings.url }}"
                class="resource-card__link"
                {%- if rtype == 'PDF' %} download target="_blank" rel="noopener"{% endif -%}
              >
                {%- if rtype == 'PDF' -%}Download &#8594;
                {%- elsif rtype == 'Video' -%}Watch &#8594;
                {%- else -%}View &#8594;
                {%- endif -%}
              </a>
            {%- endif -%}

          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Resource Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Resources for Clinicians"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section subheading"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading & text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left (default)"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium (default)"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "resource",
      "name": "Resource",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Resource title",
          "default": "Trauma Assessment Checklist"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Resource URL"
        },
        {
          "type": "select",
          "id": "resource_type",
          "label": "Resource type",
          "options": [
            {
              "value": "PDF",
              "label": "PDF"
            },
            {
              "value": "Video",
              "label": "Video"
            },
            {
              "value": "Article",
              "label": "Article"
            },
            {
              "value": "Link",
              "label": "Link"
            }
          ],
          "default": "PDF"
        }
      ]
