<style>
  .three-branch {
    padding: var(--space-9) 0;
    background: var(--cfbl-deep-navy);
  }

  .three-branch__head {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-8);
    text-align: center;
  }

  .three-branch__eyebrow {
    font-family: var(--cfbl-font-body);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--cfbl-sand);
    font-weight: 600;
    margin: 0 0 var(--space-3);
    display: block;
    opacity: 0.75;
  }

  .three-branch__title {
    font-family: var(--cfbl-font-display);
    color: var(--cfbl-sand-pale);
    font-weight: 500;
    font-size: clamp(1.875rem, 3.2vw, 2.5rem);
    margin: 0 0 var(--space-4);
    line-height: 1.15;
  }

  .three-branch__subtitle {
    font-family: var(--cfbl-font-body);
    color: var(--cfbl-sand);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0 auto;
    opacity: 0.85;
  }

  .three-branch__grid {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .branch-panel {
    padding: var(--space-7) var(--space-6);
  }

  .branch-panel:not(:last-child) {
    border-right: 1px solid var(--cfbl-rule);
  }

  .branch-panel--cfbl      { background: var(--cfbl-sand); }
  .branch-panel--institute { background: #dce6e0; }
  .branch-panel--musa      { background: #F7F2EA; }

  .branch-label {
    display: block;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
    margin: 0 0 var(--space-4);
  }

  .branch-panel--cfbl      .branch-label { font-family: var(--cfbl-font-body);      color: var(--cfbl-terracotta); }
  .branch-panel--institute .branch-label { font-family: var(--inst-font-utility);   color: var(--inst-forest); }
  .branch-panel--musa      .branch-label { font-family: var(--musa-font-utility);   color: var(--musa-oxblood); }

  .branch-heading {
    margin: 0 0 var(--space-4);
    line-height: 1.15;
  }

  .branch-panel--cfbl      .branch-heading { font-family: var(--cfbl-font-display);  color: var(--cfbl-deep-navy); font-size: clamp(1.5rem, 2.2vw, 1.875rem); font-weight: 500; }
  .branch-panel--institute .branch-heading { font-family: var(--inst-font-display);  color: var(--inst-forest);    font-size: clamp(1.5rem, 2.2vw, 1.875rem); font-weight: 500; }
  .branch-panel--musa      .branch-heading { font-family: var(--musa-font-display);  color: var(--musa-ink);       font-size: clamp(1.5rem, 2.2vw, 1.875rem); font-weight: 400; }

  .branch-body {
    margin: 0 0 var(--space-6);
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  .branch-panel--cfbl      .branch-body { font-family: var(--cfbl-font-body);   color: var(--cfbl-ink); }
  .branch-panel--institute .branch-body { font-family: var(--inst-font-body);   color: var(--inst-ink); }
  .branch-panel--musa      .branch-body { font-family: var(--musa-font-body);   color: var(--musa-ink); }

  .branch-cta {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .branch-panel--cfbl      .branch-cta { font-family: var(--cfbl-font-body);    color: var(--cfbl-sky-blue); }
  .branch-panel--institute .branch-cta { font-family: var(--inst-font-utility); color: var(--inst-forest); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; }
  .branch-panel--musa      .branch-cta { font-family: var(--musa-font-utility); color: var(--musa-oxblood); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; }

  .branch-cta:hover { text-decoration: underline; text-underline-offset: 3px; }

  .branch-logo {
    display: block;
    max-height: 44px;
    max-width: 130px;
    width: auto;
    object-fit: contain;
    margin: 0 0 var(--space-5);
  }

  @media (max-width: 768px) {
    .three-branch__grid {
      grid-template-columns: 1fr;
    }
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

<section class="three-branch" id="section-{{ section.id }}" aria-label="Three brand pathways overview">
  <div class="three-branch__head">
    {% if section.settings.eyebrow != blank %}
      <span class="three-branch__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="three-branch__title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="three-branch__subtitle">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="three-branch__grid">
    <div class="branch-panel branch-panel--cfbl">
      {%- if section.settings.cfbl_logo != blank -%}
        {{ section.settings.cfbl_logo | image_url: width: 260 | image_tag: class: 'branch-logo', loading: 'lazy', alt: 'Center for Balanced Living' }}
      {%- endif -%}
      <span class="branch-label">For Clients</span>
      <h3 class="branch-heading">{{ section.settings.cfbl_heading | default: 'Center for Balanced Living' }}</h3>
      <p class="branch-body">{{ section.settings.cfbl_body | default: 'Therapy, psychological evaluation, groups, and consultation for individuals and families. Trauma-informed care in Middletown, DE.' }}</p>
      {% if section.settings.cfbl_cta_label != blank %}
        <a href="{{ section.settings.cfbl_cta_url | default: '/pages/cfbl' }}" class="branch-cta">
          {{ section.settings.cfbl_cta_label }} →
        </a>
      {% endif %}
    </div>

    <div class="branch-panel branch-panel--institute">
      {%- if section.settings.inst_logo != blank -%}
        {{ section.settings.inst_logo | image_url: width: 260 | image_tag: class: 'branch-logo', loading: 'lazy', alt: 'CFBL Institute' }}
      {%- endif -%}
      <span class="branch-label">For Professionals</span>
      <h3 class="branch-heading">{{ section.settings.inst_heading | default: 'CFBL Institute' }}</h3>
      <p class="branch-body">{{ section.settings.inst_body | default: 'Continuing education in trauma-based practice, assessment, and applied clinical reasoning. For licensed clinicians.' }}</p>
      {% if section.settings.inst_cta_label != blank %}
        <a href="{{ section.settings.inst_cta_url | default: '/pages/institute' }}" class="branch-cta">
          {{ section.settings.inst_cta_label }} →
        </a>
      {% endif %}
    </div>

    <div class="branch-panel branch-panel--musa">
      {%- if section.settings.musa_logo != blank -%}
        {{ section.settings.musa_logo | image_url: width: 260 | image_tag: class: 'branch-logo', loading: 'lazy', alt: 'MUSA' }}
      {%- endif -%}
      <span class="branch-label">For Readers</span>
      <h3 class="branch-heading">{{ section.settings.musa_heading | default: 'MUSA' }}</h3>
      <p class="branch-body">{{ section.settings.musa_body | default: 'Books, essays, and longer-form writing on psychology, memory, and being human. A publication by Dr. Angela Serravalle.' }}</p>
      {% if section.settings.musa_cta_label != blank %}
        <a href="{{ section.settings.musa_cta_url | default: '/pages/musa' }}" class="branch-cta">
          {{ section.settings.musa_cta_label }} →
        </a>
      {% endif %}
    </div>
  </div>
</section>

