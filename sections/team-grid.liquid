<style>
  /* Section must not have overflow:hidden — sticky needs it */
  #shopify-section-{{ section.id }} {
    background: var(--cfbl-sand-pale);
  }

  #shopify-section-{{ section.id }} .team-section {
    padding: var(--space-9) 0 0;
  }

  #shopify-section-{{ section.id }} .team-head-wrap {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-8);
  }

  #shopify-section-{{ section.id }} .team-grid-section__eyebrow {
    font-family: var(--cfbl-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cfbl-terracotta);
    margin: 0 0 var(--space-3);
  }

  #shopify-section-{{ section.id }} .team-grid-section__heading {
    font-family: var(--cfbl-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-grid-section__subheading {
    font-family: var(--cfbl-font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: var(--space-4) 0 0;
  }

  /* Sticky scroll container */
  #shopify-section-{{ section.id }} .team-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--cfbl-sand-pale);
  }

  #shopify-section-{{ section.id }} .team-hscroll {
    width: 100%;
    overflow: hidden;
    padding: var(--space-3) 0 var(--space-7);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 92%, transparent 100%);
  }

  #shopify-section-{{ section.id }} .team-hscroll__track {
    display: flex;
    gap: var(--space-6);
    padding: 0 var(--space-6);
    width: max-content;
    will-change: transform;
    transition: transform 0.05s linear;
  }

  /* Cards */
  #shopify-section-{{ section.id }} .team-card {
    flex-shrink: 0;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  #shopify-section-{{ section.id }} .team-card__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--cfbl-sand-light);
  }

  #shopify-section-{{ section.id }} .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  #shopify-section-{{ section.id }} .team-card__photo-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--cfbl-sand-light);
    border-radius: var(--radius-sm);
    border: 1px solid var(--cfbl-rule);
  }

  #shopify-section-{{ section.id }} .team-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  #shopify-section-{{ section.id }} .team-card__name {
    font-family: var(--cfbl-font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-card__credentials {
    font-family: var(--cfbl-font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--cfbl-terracotta);
    line-height: 1.4;
    margin: 0;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .team-card__role {
    font-family: var(--cfbl-font-body);
    font-size: 0.875rem;
    color: var(--cfbl-ink);
    line-height: 1.4;
    margin: 0;
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .team-card__bio {
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: var(--space-1) 0 0;
  }

  #shopify-section-{{ section.id }} .team-card__link {
    font-family: var(--cfbl-font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cfbl-sky-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    align-self: flex-start;
    margin-top: var(--space-2);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .team-card__link:hover {
    color: var(--cfbl-deep-navy);
  }

  /* Mobile: static horizontal scroll snap, no JS effect */
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .team-section {
      padding-bottom: var(--space-9);
    }

    #shopify-section-{{ section.id }} .team-sticky {
      position: relative;
      height: auto;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .team-hscroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      -webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%);
      mask-image: linear-gradient(to right, black 80%, transparent 100%);
      padding-bottom: var(--space-4);
    }

    #shopify-section-{{ section.id }} .team-hscroll__track {
      transition: none;
    }

    #shopify-section-{{ section.id }} .team-card {
      scroll-snap-align: start;
    }
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
</style>

<section
  class="team-section brand-cfbl"
  id="team-section-{{ section.id }}"
  aria-labelledby="team-heading-{{ section.id }}"
>
  <div class="team-head-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="team-grid-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="team-grid-section__heading" id="team-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="team-grid-section__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="team-sticky">
    <div class="team-hscroll" id="team-hscroll-{{ section.id }}">
      <div class="team-hscroll__track" id="team-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="team-card" {{ block.shopify_attributes }}>
            <div class="team-card__photo">
              {%- if block.settings.photo != blank -%}
                {{
                  block.settings.photo
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.name,
                    widths: '280, 420, 560',
                    sizes: '280px'
                }}
              {%- else -%}
                <div class="team-card__photo-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <div class="team-card__body">
              {%- if block.settings.name != blank -%}
                <h3 class="team-card__name">{{ block.settings.name | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.credentials != blank -%}
                <p class="team-card__credentials">{{ block.settings.credentials | escape }}</p>
              {%- endif -%}
              {%- if block.settings.role != blank -%}
                <p class="team-card__role">{{ block.settings.role | escape }}</p>
              {%- endif -%}
              {%- if block.settings.bio_short != blank -%}
                <p class="team-card__bio">{{ block.settings.bio_short }}</p>
              {%- endif -%}
              {%- if block.settings.url != blank -%}
                <a href="{{ block.settings.url }}" class="team-card__link">
                  {{ block.settings.cta_label | default: 'View Full Bio' | escape }} &#8594;
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var sid    = '{{ section.id }}';
  var wrap   = document.getElementById('team-section-' + sid);
  var hscroll = document.getElementById('team-hscroll-' + sid);
  var track  = document.getElementById('team-track-' + sid);
  if (!wrap || !hscroll || !track) return;

  var dist = 0;

  function setup () {
    if (window.innerWidth < 768) {
      wrap.style.paddingBottom = '';
      track.style.transform = '';
      return;
    }
    dist = Math.max(0, track.scrollWidth - hscroll.offsetWidth);
    /* Pad section so sticky has room to travel */
    wrap.style.paddingBottom = dist + 'px';
    tick();
  }

  function tick () {
    if (window.innerWidth < 768 || dist === 0) return;
    var top = wrap.getBoundingClientRect().top;
    var progress = Math.max(0, Math.min(1, -top / dist));
    track.style.transform = 'translateX(' + (-progress * dist) + 'px)';
  }

  setup();
  window.addEventListener('resize', setup, { passive: true });
  window.addEventListener('scroll', tick,  { passive: true });
})();
</script>

{% schema %}
{
  "name": "Team Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Team"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Meet the Team"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section subheading"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium (default)" },
        { "value": "large", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium (default)" },
        { "value": "large", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left (default)" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium (default)" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Portrait photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Full name",
          "default": "Dr. Angela Serravalle"
        },
        {
          "type": "text",
          "id": "credentials",
          "label": "Credentials (e.g. Psy.D., LPCMH)",
          "default": "Psy.D., LPCMH, NCC"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / title",
          "default": "Founder and Licensed Psychologist"
        },
        {
          "type": "textarea",
          "id": "bio_short",
          "label": "Short bio (1-2 sentences)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile page URL (optional)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Link label",
          "default": "View Full Bio"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Grid",
      "blocks": [
        {
          "type": "member",
          "settings": {
            "name": "Dr. Angela (Niki) Serravalle",
            "credentials": "Psy.D., LPCMH, NCC",
            "role": "Founder and Licensed Psychologist"
          }
        }
      ]
    }
  ]
}
{% endschema %}
