<style>
  #shopify-section-{{ section.id }} .team-grid-section {
    background: var(--cfbl-sand);
    padding: var(--space-9) 0;
  }

  #shopify-section-{{ section.id }} .team-grid-section__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  #shopify-section-{{ section.id }} .team-grid-section__head {
    max-width: 560px;
    margin: 0 0 var(--space-8);
  }

  #shopify-section-{{ section.id }} .team-grid-section__heading {
    font-family: var(--cfbl-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-grid-section__subheading {
    font-family: var(--cfbl-font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: var(--space-4) 0 0;
  }

  #shopify-section-{{ section.id }} .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-7) var(--space-6);
  }

  #shopify-section-{{ section.id }} .team-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  #shopify-section-{{ section.id }} .team-card__photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--cfbl-sand-light);
  }

  #shopify-section-{{ section.id }} .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform var(--dur-slow) var(--ease);
  }

  #shopify-section-{{ section.id }} .team-card:hover .team-card__photo img {
    transform: scale(1.02);
  }

  #shopify-section-{{ section.id }} .team-card__photo-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--cfbl-sand-light);
    border-radius: var(--radius-sm);
    border: 1px solid var(--cfbl-rule);
  }

  #shopify-section-{{ section.id }} .team-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  #shopify-section-{{ section.id }} .team-card__name {
    font-family: var(--cfbl-font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-card__title {
    font-family: var(--cfbl-font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--cfbl-terracotta);
    line-height: 1.4;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-card__bio {
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: var(--space-1) 0 0;
  }

  #shopify-section-{{ section.id }} .team-card__link {
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--cfbl-sky-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    align-self: flex-start;
    margin-top: var(--space-2);
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .team-card__link:hover {
    color: var(--cfbl-deep-navy);
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    #shopify-section-{{ section.id }} .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="team-grid-section brand-cfbl" aria-labelledby="team-heading-{{ section.id }}">
  <div class="team-grid-section__inner">
    <div class="team-grid-section__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="team-grid-section__heading" id="team-heading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="team-grid-section__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="team-grid">
        {%- for block in section.blocks -%}
          <div class="team-card" {{ block.shopify_attributes }}>
            <div class="team-card__photo">
              {%- if block.settings.photo != blank -%}
                {{
                  block.settings.photo
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.name | escape,
                    widths: '300, 450, 600',
                    sizes: '(max-width: 500px) 100vw, (max-width: 900px) 50vw, 33vw'
                }}
              {%- else -%}
                <div class="team-card__photo-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>

            <div class="team-card__body">
              {%- if block.settings.name != blank -%}
                <h3 class="team-card__name">{{ block.settings.name | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="team-card__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.bio != blank -%}
                <p class="team-card__bio">{{ block.settings.bio }}</p>
              {%- endif -%}
              {%- if block.settings.url != blank -%}
                <a href="{{ block.settings.url }}" class="team-card__link">
                  Meet {{ block.settings.name | escape | split: ' ' | first }} &#8594;
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Team Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Meet the Team"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section subheading"
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team member",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Portrait photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Full name",
          "default": "Dr. Angela Serravalle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title and credentials",
          "default": "Psy.D., LPCMH, NCC"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Short bio (1-2 sentences)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile page URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Grid",
      "blocks": [
        {
          "type": "team_member",
          "settings": {
            "name": "Dr. Angela Serravalle",
            "title": "Psy.D., LPCMH, NCC · Founder"
          }
        }
      ]
    }
  ]
}
{% endschema %}
