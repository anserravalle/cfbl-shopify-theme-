<style>
  #shopify-section-{{ section.id }} .team-grid-section {
    background: var(--cfbl-sand-pale);
    padding: var(--space-9) 0;
  }

  #shopify-section-{{ section.id }} .team-grid-section__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  #shopify-section-{{ section.id }} .team-grid-section__head {
    max-width: 560px;
    margin: 0 0 var(--space-8);
  }

  #shopify-section-{{ section.id }} .team-grid-section__heading {
    font-family: var(--cfbl-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-grid-section__subheading {
    font-family: var(--cfbl-font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: var(--space-4) 0 0;
  }

  #shopify-section-{{ section.id }} .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-7) var(--space-6);
  }

  #shopify-section-{{ section.id }} .team-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  #shopify-section-{{ section.id }} .team-card__photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--cfbl-sand-light);
  }

  #shopify-section-{{ section.id }} .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform var(--dur-slow) var(--ease);
  }

  #shopify-section-{{ section.id }} .team-card:hover .team-card__photo img {
    transform: scale(1.02);
  }

  #shopify-section-{{ section.id }} .team-card__photo-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--cfbl-sand-light);
    border-radius: var(--radius-sm);
    border: 1px solid var(--cfbl-rule);
  }

  #shopify-section-{{ section.id }} .team-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  #shopify-section-{{ section.id }} .team-card__name {
    font-family: var(--cfbl-font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-card__title {
    font-family: var(--cfbl-font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--cfbl-terracotta);
    line-height: 1.4;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .team-card__bio {
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: var(--space-1) 0 0;
  }

  #shopify-section-{{ section.id }} .team-card__link {
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--cfbl-sky-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    align-self: flex-start;
    margin-top: var(--space-2);
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .team-card__link:hover {
    color: var(--cfbl-deep-navy);
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    #shopify-section-{{ section.id }} .team-grid {
      grid-template-columns: 1fr;
    }
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

<section class="team-grid-section brand-cfbl" aria-labelledby="team-heading-{{ section.id }}">
  <div class="team-grid-section__inner">
    <div class="team-grid-section__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="team-grid-section__heading" id="team-heading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="team-grid-section__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="team-grid">
        {%- for block in section.blocks -%}
          <div class="team-card" {{ block.shopify_attributes }}>
            <div class="team-card__photo">
              {%- if block.settings.photo != blank -%}                {%- assign member_alt = block.settings.name | escape -%}
                {{
                  block.settings.photo
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    alt: member_alt,
                    widths: '300, 450, 600',
                    sizes: '(max-width: 500px) 100vw, (max-width: 900px) 50vw, 33vw'
                }}
              {%- else -%}
                <div class="team-card__photo-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>

            <div class="team-card__body">
              {%- if block.settings.name != blank -%}
                <h3 class="team-card__name">{{ block.settings.name | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="team-card__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.bio != blank -%}
                <p class="team-card__bio">{{ block.settings.bio }}</p>
              {%- endif -%}
              {%- if block.settings.url != blank -%}
                <a href="{{ block.settings.url }}" class="team-card__link">
                  Meet {{ block.settings.name | escape | split: ' ' | first }} &#8594;
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Team Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Meet the Team"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section subheading"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading & text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left (default)"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium (default)"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Portrait photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Full name",
          "default": "Dr. Angela Serravalle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title and credentials",
          "default": "Psy.D., LPCMH, NCC"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Short bio (1-2 sentences)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile page URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Grid",
      "blocks": [
        {
          "type": "member",
          "settings": {
            "name": "Dr. Angela Serravalle",
            "title": "Psy.D., LPCMH, NCC \u00b7 Founder"
          }
        }
      ]
    }
  ]
}
{% endschema %}