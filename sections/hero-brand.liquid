{% liquid
  assign brand = section.settings.brand | default: 'cfbl'
  assign has_image = false
  if section.settings.background_image != blank
    assign has_image = true
  endif
%}

<style>
  #shopify-section-{{ section.id }} .hero-brand {
    padding: var(--space-10) 0;
  }

  #shopify-section-{{ section.id }} .hero-brand--cfbl {
    background: var(--cfbl-sand);
  }

  #shopify-section-{{ section.id }} .hero-brand--institute {
    background: var(--inst-cream);
  }

  #shopify-section-{{ section.id }} .hero-brand--musa {
    background: var(--musa-bone);
  }

  #shopify-section-{{ section.id }} .hero-brand__container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-8);
    min-height: 640px;
  }

  #shopify-section-{{ section.id }} .hero-brand__container--has-image {
    grid-template-columns: 55fr 45fr;
  }

  #shopify-section-{{ section.id }} .hero-brand__eyebrow {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .hero-brand__eyebrow--cfbl    { color: var(--cfbl-terracotta); }
  #shopify-section-{{ section.id }} .hero-brand__eyebrow--institute { color: var(--inst-sage); font-family: var(--inst-font-utility); }
  #shopify-section-{{ section.id }} .hero-brand__eyebrow--musa    { color: var(--musa-walnut); font-family: var(--musa-font-utility); }

  #shopify-section-{{ section.id }} .hero-brand__heading--cfbl {
    font-family: var(--cfbl-font-display);
    color: var(--cfbl-deep-navy);
    font-size: clamp(3rem, 5.5vw, 5.5rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.12;
    margin: 0 0 var(--space-5);
  }

  #shopify-section-{{ section.id }} .hero-brand__heading--institute {
    font-family: var(--inst-font-display);
    color: var(--inst-forest);
    font-size: clamp(2.75rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0 0 var(--space-5);
  }

  #shopify-section-{{ section.id }} .hero-brand__heading--musa {
    font-family: var(--musa-font-display);
    color: var(--musa-ink);
    font-size: clamp(3rem, 5.5vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.08;
    margin: 0 0 var(--space-5);
  }

  #shopify-section-{{ section.id }} .hero-brand__lede--cfbl {
    font-family: var(--cfbl-font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: 0 0 var(--space-7);
  }

  #shopify-section-{{ section.id }} .hero-brand__lede--institute {
    font-family: var(--inst-font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--inst-ink);
    margin: 0 0 var(--space-7);
  }

  #shopify-section-{{ section.id }} .hero-brand__lede--musa {
    font-family: var(--musa-font-body);
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--musa-ink);
    margin: 0 0 var(--space-7);
  }

  #shopify-section-{{ section.id }} .hero-brand__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  /* Right-side image panel */
  #shopify-section-{{ section.id }} .hero-brand__photo-panel {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .hero-brand__photo-frame {
    width: 100%;
    border-radius: var(--radius-sm);
    padding: 10px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hero-brand--cfbl     .hero-brand__photo-frame { background: #D4BFA8; }
  #shopify-section-{{ section.id }} .hero-brand--institute .hero-brand__photo-frame { background: #C8BBA5; }
  #shopify-section-{{ section.id }} .hero-brand--musa      .hero-brand__photo-frame { background: #CFC3AE; }

  #shopify-section-{{ section.id }} .hero-brand__photo-frame img {
    width: 100%;
    display: block;
    border-radius: calc(var(--radius-sm) - 4px);
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hero-brand__container--has-image {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .hero-brand__photo-panel {
      display: none;
    }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .hero-brand__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

<section
  class="hero-brand hero-brand--{{ brand }} brand-{{ brand }}"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="hero-brand__container {% if has_image %}hero-brand__container--has-image{% endif %}">

    <div class="hero-brand__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero-brand__eyebrow hero-brand__eyebrow--{{ brand }}">
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-brand__heading--{{ brand }}">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-brand__lede--{{ brand }}">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank -%}
        <div class="hero-brand__actions">
          {%- if section.settings.cta_primary_label != blank -%}
            <a href="{{ section.settings.cta_primary_url }}" class="btn btn-primary">
              {{ section.settings.cta_primary_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a href="{{ section.settings.cta_secondary_url }}" class="btn btn-secondary">
              {{ section.settings.cta_secondary_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if has_image -%}
      <div class="hero-brand__photo-panel" aria-hidden="true">
        <div class="hero-brand__photo-frame">
          {%- assign hero_img_alt = section.settings.heading | escape -%}
          {{
            section.settings.background_image
            | image_url: width: 900
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_img_alt,
              widths: '450, 600, 750, 900',
              sizes: '(max-width: 768px) 0px, 45vw'
          }}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Hero: Brand",
  "settings": [
    {
      "type": "select",
      "id": "brand",
      "label": "Brand context",
      "options": [
        {
          "value": "cfbl",
          "label": "Center for Balanced Living"
        },
        {
          "value": "institute",
          "label": "CFBL Institute"
        },
        {
          "value": "musa",
          "label": "MUSA"
        }
      ],
      "default": "cfbl"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / kicker text",
      "default": "Trauma-Based Clinical Services \u00b7 Middletown, DE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Healing Happens In Relationship."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Lead paragraph",
      "default": "We pair evidence-based care with warmth, attunement, and a holistic approach to mind, body, and spirit."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Schedule a Consultation"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading & text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left (default)"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium (default)"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Hero: CFBL",
      "settings": {
        "brand": "cfbl",
        "eyebrow": "Trauma-Based Clinical Services \u00b7 Middletown, DE",
        "heading": "Healing Happens In Relationship.",
        "subheading": "We pair evidence-based care with warmth, attunement, and a holistic approach to mind, body, and spirit.",
        "cta_primary_label": "Schedule a Consultation",
        "cta_secondary_label": "Meet the Team"
      }
    },
    {
      "name": "Hero: Institute",
      "settings": {
        "brand": "institute",
        "eyebrow": "Continuing Education \u00b7 Established 2024",
        "heading": "Clinically rigorous training for trauma-based practice.",
        "subheading": "Live workshops, on-demand courses, and consultation for licensed clinicians.",
        "cta_primary_label": "View Trainings",
        "cta_secondary_label": "Apply for CE Credit"
      }
    },
    {
      "name": "Hero: MUSA",
      "settings": {
        "brand": "musa",
        "eyebrow": "Essays & Publications",
        "heading": "New writing on psychology, memory, and being human.",
        "subheading": "By Angela Serravalle",
        "cta_primary_label": "Read the Essays"
      }
    }
  ]
}
{% endschema %}