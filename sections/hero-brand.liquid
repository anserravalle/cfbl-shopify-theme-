{% liquid
  assign brand = section.settings.brand | default: 'cfbl'
  assign has_image = false
  if section.settings.background_image != blank
    assign has_image = true
  endif
%}

<style>
  #shopify-section-{{ section.id }} .hero-brand {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hero-brand--cfbl {
    background: var(--cfbl-sand);
  }

  #shopify-section-{{ section.id }} .hero-brand--institute {
    background: var(--inst-cream);
  }

  #shopify-section-{{ section.id }} .hero-brand--musa {
    background: var(--musa-bone);
  }

  #shopify-section-{{ section.id }} .hero-brand__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .hero-brand__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #shopify-section-{{ section.id }} .hero-brand__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .hero-brand__veil--cfbl {
    background: rgba(238, 217, 197, 0.55);
  }

  #shopify-section-{{ section.id }} .hero-brand__veil--institute {
    background: rgba(234, 226, 208, 0.58);
  }

  #shopify-section-{{ section.id }} .hero-brand__veil--musa {
    background: rgba(241, 232, 216, 0.55);
  }

  #shopify-section-{{ section.id }} .hero-brand__content {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    width: 100%;
    margin: 0 auto;
    padding: var(--space-10) var(--space-6);
  }

  #shopify-section-{{ section.id }} .hero-brand__inner {
    max-width: 600px;
  }

  #shopify-section-{{ section.id }} .hero-brand__eyebrow {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .hero-brand__eyebrow--cfbl {
    color: var(--cfbl-terracotta);
  }

  #shopify-section-{{ section.id }} .hero-brand__eyebrow--institute {
    color: var(--inst-sage);
    font-family: var(--inst-font-utility);
  }

  #shopify-section-{{ section.id }} .hero-brand__eyebrow--musa {
    color: var(--musa-walnut);
    font-family: var(--musa-font-utility);
  }

  #shopify-section-{{ section.id }} .hero-brand__heading--cfbl {
    font-family: var(--cfbl-font-display);
    color: var(--cfbl-deep-navy);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.12;
    margin: 0 0 var(--space-5);
  }

  #shopify-section-{{ section.id }} .hero-brand__heading--institute {
    font-family: var(--inst-font-display);
    color: var(--inst-forest);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0 0 var(--space-5);
  }

  #shopify-section-{{ section.id }} .hero-brand__heading--musa {
    font-family: var(--musa-font-display);
    color: var(--musa-ink);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.08;
    margin: 0 0 var(--space-5);
  }

  #shopify-section-{{ section.id }} .hero-brand__lede--cfbl {
    font-family: var(--cfbl-font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: 0 0 var(--space-7);
  }

  #shopify-section-{{ section.id }} .hero-brand__lede--institute {
    font-family: var(--inst-font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--inst-ink);
    margin: 0 0 var(--space-7);
  }

  #shopify-section-{{ section.id }} .hero-brand__lede--musa {
    font-family: var(--musa-font-body);
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--musa-ink);
    margin: 0 0 var(--space-7);
  }

  #shopify-section-{{ section.id }} .hero-brand__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .hero-brand {
      min-height: 480px;
    }

    #shopify-section-{{ section.id }} .hero-brand__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<section
  class="hero-brand hero-brand--{{ brand }} brand-{{ brand }}"
  aria-label="{{ section.settings.heading | escape }}"
>
  {%- if has_image -%}
    <div class="hero-brand__media" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: '',
          widths: '750, 1100, 1500, 1800, 2000',
          sizes: '100vw'
      }}
    </div>
    <div class="hero-brand__veil hero-brand__veil--{{ brand }}" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero-brand__content">
    <div class="hero-brand__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero-brand__eyebrow hero-brand__eyebrow--{{ brand }}">
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-brand__heading--{{ brand }}">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-brand__lede--{{ brand }}">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank -%}
        <div class="hero-brand__actions">
          {%- if section.settings.cta_primary_label != blank -%}
            <a
              href="{{ section.settings.cta_primary_url }}"
              class="btn btn-primary"
            >{{ section.settings.cta_primary_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a
              href="{{ section.settings.cta_secondary_url }}"
              class="btn btn-secondary"
            >{{ section.settings.cta_secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero — Brand",
  "settings": [
    {
      "type": "select",
      "id": "brand",
      "label": "Brand context",
      "options": [
        { "value": "cfbl", "label": "Center for Balanced Living" },
        { "value": "institute", "label": "CFBL Institute" },
        { "value": "musa", "label": "MUSA" }
      ],
      "default": "cfbl"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / kicker text",
      "default": "Trauma-Informed Psychology · Middletown, DE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Healing Happens In Relationship."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Lead paragraph",
      "default": "We pair evidence-based care with warmth, attunement, and a holistic approach to mind, body, and spirit."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Schedule a Consultation"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    }
  ],
  "presets": [
    {
      "name": "Hero — CFBL",
      "settings": {
        "brand": "cfbl",
        "eyebrow": "Trauma-Informed Psychology · Middletown, DE",
        "heading": "Healing Happens In Relationship.",
        "subheading": "We pair evidence-based care with warmth, attunement, and a holistic approach to mind, body, and spirit.",
        "cta_primary_label": "Schedule a Consultation",
        "cta_secondary_label": "Meet the Team"
      }
    },
    {
      "name": "Hero — Institute",
      "settings": {
        "brand": "institute",
        "eyebrow": "Continuing Education · Established 2024",
        "heading": "Clinically rigorous training for trauma-informed practice.",
        "subheading": "Live workshops, on-demand courses, and consultation for licensed clinicians.",
        "cta_primary_label": "View Trainings",
        "cta_secondary_label": "Apply for CE Credit"
      }
    },
    {
      "name": "Hero — MUSA",
      "settings": {
        "brand": "musa",
        "eyebrow": "Essays & Publications",
        "heading": "New writing on psychology, memory, and being human.",
        "subheading": "By Angela Serravalle",
        "cta_primary_label": "Read the Essays"
      }
    }
  ]
}
{% endschema %}
