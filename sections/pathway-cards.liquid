<style>
  #shopify-section-{{ section.id }} .pathways {
    background: var(--cfbl-sand-pale);
    padding: var(--space-9) 0;
  }

  #shopify-section-{{ section.id }} .pathways__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  #shopify-section-{{ section.id }} .pathways__head {
    margin-bottom: var(--space-8);
    max-width: 560px;
  }

  #shopify-section-{{ section.id }} .pathways__eyebrow {
    font-family: var(--cfbl-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cfbl-terracotta);
    margin: 0 0 var(--space-3);
  }

  #shopify-section-{{ section.id }} .pathways__heading {
    font-family: var(--cfbl-font-display);
    font-size: clamp(1.875rem, 3.5vw, 3rem);
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.1;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .pathway-list {
    border-top: 1px solid var(--cfbl-rule);
  }

  #shopify-section-{{ section.id }} .pathway-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: start;
    gap: var(--space-6);
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--cfbl-rule);
    text-decoration: none;
    color: inherit;
    transition: padding var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .pathway-row__num {
    font-family: var(--cfbl-font-display);
    font-size: clamp(1.375rem, 2.5vw, 2.125rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.04em;
    padding-top: 0.3rem;
  }

  #shopify-section-{{ section.id }} .pathway-row--cfbl      .pathway-row__num { color: var(--cfbl-terracotta); opacity: 0.65; }
  #shopify-section-{{ section.id }} .pathway-row--institute .pathway-row__num { color: var(--inst-sage); opacity: 0.75; }
  #shopify-section-{{ section.id }} .pathway-row--musa      .pathway-row__num { color: var(--musa-walnut); opacity: 0.65; }

  #shopify-section-{{ section.id }} .pathway-row__kicker {
    font-family: var(--cfbl-font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0 0 var(--space-2);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .pathway-row--cfbl      .pathway-row__kicker { color: var(--cfbl-terracotta); }
  #shopify-section-{{ section.id }} .pathway-row--institute .pathway-row__kicker { color: var(--inst-sage); font-family: var(--inst-font-utility); }
  #shopify-section-{{ section.id }} .pathway-row--musa      .pathway-row__kicker { color: var(--musa-walnut); font-family: var(--musa-font-utility); }

  #shopify-section-{{ section.id }} .pathway-row__title {
    margin: 0 0 var(--space-3);
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .pathway-row--cfbl      .pathway-row__title { font-family: var(--cfbl-font-display); font-size: clamp(1.375rem, 2.2vw, 1.875rem); font-weight: 500; color: var(--cfbl-deep-navy); letter-spacing: 0.01em; }
  #shopify-section-{{ section.id }} .pathway-row--institute .pathway-row__title { font-family: var(--inst-font-display); font-size: clamp(1.375rem, 2.2vw, 1.875rem); font-weight: 500; color: var(--inst-forest); }
  #shopify-section-{{ section.id }} .pathway-row--musa      .pathway-row__title { font-family: var(--musa-font-display); font-size: clamp(1.375rem, 2.2vw, 1.875rem); font-weight: 400; color: var(--musa-ink); }

  #shopify-section-{{ section.id }} .pathway-row__desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
    max-width: 52ch;
  }

  #shopify-section-{{ section.id }} .pathway-row--cfbl      .pathway-row__desc { font-family: var(--cfbl-font-body); color: var(--cfbl-ink); }
  #shopify-section-{{ section.id }} .pathway-row--institute .pathway-row__desc { font-family: var(--inst-font-body); color: var(--inst-ink); }
  #shopify-section-{{ section.id }} .pathway-row--musa      .pathway-row__desc { font-family: var(--musa-font-body); color: var(--musa-ink); }

  #shopify-section-{{ section.id }} .pathway-row__action {
    display: flex;
    align-items: flex-start;
    padding-top: 0.4rem;
    min-width: 190px;
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .pathway-row__cta {
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    transition: gap var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .pathway-row:hover .pathway-row__cta {
    gap: 0.65em;
  }

  #shopify-section-{{ section.id }} .pathway-row--cfbl      .pathway-row__cta { color: var(--cfbl-sky-blue); font-family: var(--cfbl-font-body); }
  #shopify-section-{{ section.id }} .pathway-row--institute .pathway-row__cta { color: var(--inst-forest); font-family: var(--inst-font-utility); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.1em; }
  #shopify-section-{{ section.id }} .pathway-row--musa      .pathway-row__cta { color: var(--musa-oxblood); font-family: var(--musa-font-utility); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.1em; }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .pathway-row {
      grid-template-columns: 3rem 1fr;
      grid-template-rows: auto auto;
      gap: var(--space-4);
    }

    #shopify-section-{{ section.id }} .pathway-row__action {
      grid-column: 2;
      justify-content: flex-start;
      padding-top: var(--space-3);
      min-width: 0;
    }
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .pathway-row {
      grid-template-columns: 2.5rem 1fr;
    }
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

<section class="pathways brand-cfbl" aria-labelledby="pathways-heading-{{ section.id }}">
  <div class="pathways__inner">
    <div class="pathways__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pathways__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pathways__heading" id="pathways-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pathway-list" role="list">
        {%- for block in section.blocks -%}
          {%- assign card_brand = block.settings.brand_color | default: 'cfbl' -%}
          <a
            href="{{ block.settings.cta_url }}"
            class="pathway-row pathway-row--{{ card_brand }}"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <span class="pathway-row__num" aria-hidden="true">{% if forloop.index < 10 %}0{{ forloop.index }}{% else %}{{ forloop.index }}{% endif %}</span>
            <div class="pathway-row__body">
              {%- if block.settings.kicker != blank -%}
                <p class="pathway-row__kicker">{{ block.settings.kicker | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="pathway-row__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="pathway-row__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.cta_label != blank -%}
              <div class="pathway-row__action">
                <span class="pathway-row__cta">{{ block.settings.cta_label | escape }} &#8594;</span>
              </div>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pathway Cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Where would you like to begin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Three Pathways to Support"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium (default)" },
        { "value": "large", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium (default)" },
        { "value": "large", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading & text alignment",
      "options": [
        { "value": "left", "label": "Left (default)" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium (default)" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "pathway",
      "name": "Pathway",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker (small label above title)",
          "default": "For Clients"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CFBL Clinical Services"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Therapy, psychological evaluation, groups, and consultation for individuals and families."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Explore Clinical Services"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA URL"
        },
        {
          "type": "select",
          "id": "brand_color",
          "label": "Brand color",
          "options": [
            { "value": "cfbl", "label": "CFBL (Navy)" },
            { "value": "institute", "label": "Institute (Forest)" },
            { "value": "musa", "label": "MUSA (Oxblood)" }
          ],
          "default": "cfbl"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pathway Cards",
      "blocks": [
        {
          "type": "pathway",
          "settings": {
            "kicker": "For Clients",
            "title": "Center for Balanced Living",
            "description": "Therapy, psychological evaluation, groups, and consultation for individuals and families.",
            "cta_label": "Explore Clinical Services",
            "brand_color": "cfbl"
          }
        },
        {
          "type": "pathway",
          "settings": {
            "kicker": "For Professionals",
            "title": "CFBL Institute",
            "description": "Continuing education in trauma-based practice, assessment, and applied clinical reasoning.",
            "cta_label": "View Trainings and CE",
            "brand_color": "institute"
          }
        },
        {
          "type": "pathway",
          "settings": {
            "kicker": "For Readers",
            "title": "MUSA",
            "description": "Books, essays, and longer-form writing on psychology, memory, and being human.",
            "cta_label": "Read the Essays",
            "brand_color": "musa"
          }
        }
      ]
    }
  ]
}
{% endschema %}
