      "default": "left"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "select",
      "id": "section_background",
      "label": "Background",
      "options": [
        {
          "value": "sand",
          "label": "Sand (CFBL)"
        },
        {
          "value": "cream",
          "label": "Cream (Institute)"
        },
        {
          "value": "bone",
          "label": "Bone (MUSA)"
        },
        {
          "value": "white",
          "label": "White"
