<style>
  #shopify-section-{{ section.id }} .event-list-section {
    background: var(--inst-paper);
    padding: var(--space-9) 0;
  }

  #shopify-section-{{ section.id }} .event-list-section__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  #shopify-section-{{ section.id }} .event-list-section__heading {
    font-family: var(--inst-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    color: var(--inst-forest);
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0 0 var(--space-8);
  }

  #shopify-section-{{ section.id }} .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .event-item {
    border-top: 1px solid var(--inst-rule);
    padding: var(--space-6) 0;
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: var(--space-6);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .event-item:last-child {
    border-bottom: 1px solid var(--inst-rule);
  }

  #shopify-section-{{ section.id }} .event-item--featured {
    background: rgba(61, 90, 82, 0.04);
    margin: 0 calc(-1 * var(--space-4));
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    border-radius: var(--radius-sm);
    border-top-color: var(--inst-forest);
  }

  #shopify-section-{{ section.id }} .event-item__date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: var(--space-1);
  }

  #shopify-section-{{ section.id }} .event-item__month {
    font-family: var(--inst-font-utility);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--inst-forest);
    line-height: 1;
    margin-bottom: var(--space-1);
  }

  #shopify-section-{{ section.id }} .event-item__day {
    font-family: var(--inst-font-display);
    font-size: 2rem;
    font-weight: 500;
    color: var(--inst-forest);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .event-item__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  #shopify-section-{{ section.id }} .event-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .event-item__format-badge {
    font-family: var(--inst-font-utility);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--inst-forest);
    border: 1px solid var(--inst-rule);
    border-radius: var(--radius-sm);
    padding: 2px var(--space-2);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .event-item__time-location {
    font-family: var(--inst-font-utility);
    font-size: 0.8125rem;
    color: rgba(42, 53, 48, 0.6);
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .event-item__title {
    font-family: var(--inst-font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--inst-forest);
    letter-spacing: 0.01em;
    line-height: 1.25;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .event-item__description {
    font-family: var(--inst-font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--inst-ink);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .event-item__cta-col {
    display: flex;
    align-items: flex-start;
    padding-top: var(--space-1);
  }

  #shopify-section-{{ section.id }} .event-item__register-link {
    font-family: var(--inst-font-utility);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--inst-forest);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .event-item__register-link:hover {
    color: var(--inst-ink);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .event-item {
      grid-template-columns: 60px 1fr;
      grid-template-rows: auto auto;
    }

    #shopify-section-{{ section.id }} .event-item__cta-col {
      grid-column: 2;
      padding-top: var(--space-2);
    }
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .event-item {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .event-item__date-block {
      flex-direction: row;
      gap: var(--space-2);
      align-items: baseline;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .event-item__day {
      font-size: 1.5rem;
    }

    #shopify-section-{{ section.id }} .event-item__cta-col {
      grid-column: 1;
    }
  }

  {% render 'section-frame', section: section, brand: 'institute' %}
</style>

<section class="event-list-section brand-institute" aria-labelledby="events-heading-{{ section.id }}">
  <div class="event-list-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="event-list-section__heading" id="events-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="event-list" role="list">
        {%- for block in section.blocks -%}
          {%- assign date_parts = block.settings.date | split: ' ' -%}
          <li
            class="event-item {% if block.settings.is_featured %}event-item--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} Date block {%- endcomment -%}
            <div class="event-item__date-block" aria-label="{{ block.settings.date | escape }}">
              {%- if date_parts.size >= 2 -%}
                <span class="event-item__month">{{ date_parts[0] | truncate: 3, '' }}</span>
                <span class="event-item__day" aria-hidden="true">{{ date_parts[1] | remove: ',' }}</span>
              {%- else -%}
                <span class="event-item__month">{{ block.settings.date | escape }}</span>
              {%- endif -%}
            </div>

            {%- comment -%} Body {%- endcomment -%}
            <div class="event-item__body">
              <div class="event-item__meta">
                <span class="event-item__format-badge">{{ block.settings.format | escape }}</span>
                {%- if block.settings.time != blank or block.settings.location != blank -%}
                  <span class="event-item__time-location">
                    {%- if block.settings.time != blank -%}{{ block.settings.time | escape }}{%- endif -%}
                    {%- if block.settings.time != blank and block.settings.location != blank %} &middot; {% endif -%}
                    {%- if block.settings.location != blank -%}{{ block.settings.location | escape }}{%- endif -%}
                  </span>
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="event-item__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="event-item__description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>

            {%- comment -%} CTA {%- endcomment -%}
            {%- if block.settings.registration_url != blank -%}
              <div class="event-item__cta-col">
                <a href="{{ block.settings.registration_url }}" class="event-item__register-link">
                  Register &#8594;
                </a>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p style="font-family:var(--inst-font-body);color:var(--inst-ink);opacity:0.6;">No upcoming events at this time.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Event List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Upcoming Trainings & Events"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Section style",
      "info": "Full width spans the page; Boxed renders a framed, rounded card.",
      "options": [
        { "value": "full",  "label": "Full width (edge to edge)" },
        { "value": "boxed", "label": "Boxed card (framed)" }
      ],
      "default": "full"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading & text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left (default)"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium (default)"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Event title",
          "default": "Assessment for the Trauma Clinician"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date (e.g. November 14, 2026)",
          "default": "November 14, 2026"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time (e.g. 9:00am\u20135:00pm ET)"
        },
        {
          "type": "select",
          "id": "format",
          "label": "Format",
          "options": [
            {
              "value": "Live Online",
              "label": "Live Online"
            },
            {
              "value": "In-Person",
              "label": "In-Person"
            },
            {
              "value": "Hybrid",
              "label": "Hybrid"
            }
          ],
          "default": "Live Online"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location (leave blank for online)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Brief description"
        },
        {
          "type": "url",
          "id": "registration_url",
          "label": "Registration URL"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Feature this event",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Event List",
      "blocks": [
        {
          "type": "event",
          "settings": {
            "title": "Assessment for the Trauma Clinician",
            "date": "November 14, 2026",
            "time": "9:00am\u20135:00pm ET",
            "format": "Live Online",
            "is_featured": true
          }
        }
      ]
    }
  ]
}
{% endschema %}