{% liquid
  assign col_count = section.settings.columns | default: 3
%}

<style>
  #shopify-section-{{ section.id }} .services {
    background: #fff;
    padding: var(--space-9) 0;
  }

  #shopify-section-{{ section.id }} .services__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  #shopify-section-{{ section.id }} .services__head {
    max-width: 600px;
    margin: 0 0 var(--space-8);
  }

  #shopify-section-{{ section.id }} .services__eyebrow {
    font-family: var(--cfbl-font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cfbl-terracotta);
    margin: 0 0 var(--space-3);
  }

  #shopify-section-{{ section.id }} .services__heading {
    font-family: var(--cfbl-font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .services__subheading {
    font-family: var(--cfbl-font-body);
    font-size: 1.0625rem;
    color: var(--cfbl-ink);
    line-height: 1.6;
    margin: var(--space-4) 0 0;
  }

  #shopify-section-{{ section.id }} .service-grid {
    display: grid;
    grid-template-columns: repeat({{ col_count }}, 1fr);
    gap: var(--space-5);
  }

  #shopify-section-{{ section.id }} .service-card {
    background: var(--cfbl-sand-pale);
    padding: var(--space-6) var(--space-6) var(--space-7);
    border-radius: var(--radius-sm);
    border: 1px solid var(--cfbl-rule);
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .service-card__kicker {
    font-family: var(--cfbl-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cfbl-terracotta);
    margin: 0 0 var(--space-3);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .service-card__title {
    font-family: var(--cfbl-font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--cfbl-deep-navy);
    letter-spacing: 0.01em;
    line-height: 1.2;
    margin: 0 0 var(--space-3);
  }

  #shopify-section-{{ section.id }} .service-card__description {
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--cfbl-ink);
    margin: 0 0 var(--space-5);
    flex: 1;
  }

  #shopify-section-{{ section.id }} .service-card__link {
    font-family: var(--cfbl-font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--cfbl-sky-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    letter-spacing: 0.01em;
    align-self: flex-start;
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .service-card__link:hover {
    color: var(--cfbl-deep-navy);
  }

  @media (max-width: 1024px) and (min-width: 601px) {
    #shopify-section-{{ section.id }} .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .service-grid {
      grid-template-columns: 1fr;
    }
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

<section class="services brand-cfbl" aria-labelledby="services-heading-{{ section.id }}">
  <div class="services__inner">
    <div class="services__head">
      {%- if section.settings.heading != blank -%}
        <p class="services__eyebrow">For Clients</p>
        <h2 class="services__heading" id="services-heading-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="services__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="service-grid">
        {%- for block in section.blocks -%}
          <article class="service-card" {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}
              <p class="service-card__kicker">{{ block.settings.kicker | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="service-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="service-card__description">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}" class="service-card__link">
                Learn more &#8594;
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Service Cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Care that is clinically grounded and relationally warm."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section subheading"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading & text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left (default)"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium (default)"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker / eyebrow",
          "default": "Service"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service title",
          "default": "Trauma-Based Therapy"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Individual therapy for adults and adolescents navigating trauma, anxiety, grief, and identity."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service Cards",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "kicker": "Service",
            "title": "Trauma-Based Therapy",
            "description": "Individual therapy for adults and adolescents navigating trauma, anxiety, grief, and identity."
          }
        },
        {
          "type": "service",
          "settings": {
            "kicker": "Service",
            "title": "Psychological Evaluation",
            "description": "Comprehensive evaluations for children, adolescents, and adults \u2014 diagnostic clarity that informs care."
          }
        },
        {
          "type": "service",
          "settings": {
            "kicker": "Service",
            "title": "Groups & Workshops",
            "description": "Community-grounded groups focused on grief, parenting, and somatic resourcing."
          }
        },
        {
          "type": "service",
          "settings": {
            "kicker": "Service",
            "title": "Consultation",
            "description": "Case consultation for clinicians and referral conversations for families."
          }
        }
      ]
    }
  ]
}
{% endschema %}