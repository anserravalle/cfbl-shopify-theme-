{% liquid
  assign brand = section.settings.brand | default: 'cfbl'
  assign has_image = false
  if section.settings.bg_image != blank
    assign has_image = true
  endif
  assign overlay = section.settings.overlay_opacity | default: 55
  assign overlay_alpha = overlay | times: 1.0 | divided_by: 100.0
%}

<style>
  #shopify-section-{{ section.id }} .feature-banner {
    position: relative;
    min-height: {{ section.settings.min_height | default: 500 }}px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  {%- unless has_image -%}
  #shopify-section-{{ section.id }} .feature-banner {
    {%- if brand == 'institute' -%}
    background: var(--inst-forest);
    {%- elsif brand == 'musa' -%}
    background: var(--musa-ink);
    {%- else -%}
    background: var(--cfbl-deep-navy);
    {%- endif -%}
  }
  {%- endunless -%}

  #shopify-section-{{ section.id }} .feature-banner__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .feature-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position | default: 'center center' }};
    display: block;
  }

  #shopify-section-{{ section.id }} .feature-banner__overlay {
    position: absolute;
    inset: 0;
    {%- if brand == 'institute' -%}
    background: rgba(27, 50, 35, {{ overlay_alpha }});
    {%- elsif brand == 'musa' -%}
    background: rgba(40, 28, 20, {{ overlay_alpha }});
    {%- else -%}
    background: rgba(27, 50, 72, {{ overlay_alpha }});
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .feature-banner__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--space-10) 0;
  }

  #shopify-section-{{ section.id }} .feature-banner__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
    {%- if section.settings.text_align == 'center' -%}
    text-align: center;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .feature-banner__inner--narrow {
    max-width: 700px;
    {%- if section.settings.text_align == 'center' -%}
    margin-left: auto;
    margin-right: auto;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .feature-banner__eyebrow {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin: 0 0 var(--space-4);
    line-height: 1;
    {%- if brand == 'institute' -%}
    color: var(--inst-sage);
    font-family: var(--inst-font-utility);
    {%- elsif brand == 'musa' -%}
    color: var(--musa-sand);
    font-family: var(--musa-font-utility);
    {%- else -%}
    color: var(--cfbl-sand);
    font-family: var(--cfbl-font-body);
    opacity: 0.75;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .feature-banner__heading {
    margin: 0 0 var(--space-5);
    line-height: 1.12;
    color: #fff;
    {%- if brand == 'institute' -%}
    font-family: var(--inst-font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    {%- elsif brand == 'musa' -%}
    font-family: var(--musa-font-display);
    font-size: clamp(2rem, 4.5vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    {%- else -%}
    font-family: var(--cfbl-font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .feature-banner__lede {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.82);
    margin: 0 0 var(--space-7);
    max-width: 54ch;
    {%- if brand == 'institute' -%}
    font-family: var(--inst-font-body);
    {%- elsif brand == 'musa' -%}
    font-family: var(--musa-font-body);
    {%- else -%}
    font-family: var(--cfbl-font-body);
    {%- endif -%}
    {%- if section.settings.text_align == 'center' -%}
    margin-left: auto;
    margin-right: auto;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .feature-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    {%- if section.settings.text_align == 'center' -%}
    justify-content: center;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .feature-banner__cta-secondary {
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    letter-spacing: 0.01em;
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .feature-banner__cta-secondary:hover {
    color: #fff;
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .feature-banner {
      min-height: 380px;
    }

    #shopify-section-{{ section.id }} .feature-banner__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<section class="feature-banner brand-{{ brand }}" aria-labelledby="fbanner-{{ section.id }}">
  {%- if has_image -%}
    <div class="feature-banner__bg" aria-hidden="true">
      {{
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          widths: '800, 1200, 1600, 2000',
          sizes: '100vw',
          alt: ''
      }}
      <div class="feature-banner__overlay"></div>
    </div>
  {%- else -%}
    <div class="feature-banner__bg" aria-hidden="true">
      <div class="feature-banner__overlay" style="opacity:1;"></div>
    </div>
  {%- endif -%}

  <div class="feature-banner__content">
    <div class="feature-banner__inner feature-banner__inner--narrow">
      {%- if section.settings.eyebrow != blank -%}
        <span class="feature-banner__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="feature-banner__heading" id="fbanner-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="feature-banner__lede">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank or section.settings.cta_secondary_label != blank -%}
        <div class="feature-banner__actions">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url }}" class="btn btn-primary">
              {{ section.settings.cta_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a href="{{ section.settings.cta_secondary_url }}" class="feature-banner__cta-secondary">
              {{ section.settings.cta_secondary_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Banner",
  "settings": [
    {
      "type": "select",
      "id": "brand",
      "label": "Brand",
      "options": [
        { "value": "cfbl", "label": "Center for Balanced Living" },
        { "value": "institute", "label": "CFBL Institute" },
        { "value": "musa", "label": "MUSA" }
      ],
      "default": "cfbl"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focus",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 85,
      "step": 5,
      "label": "Image overlay darkness",
      "default": 55
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 300,
      "max": 800,
      "step": 50,
      "label": "Minimum height (px)",
      "default": 500
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Feature Banner",
      "settings": {
        "brand": "cfbl",
        "heading": "Your Path To Healing Begins Here",
        "subheading": "Trauma-based care for individuals, families, and children. Accepting new clients.",
        "cta_label": "Schedule a Consultation",
        "overlay_opacity": 55,
        "min_height": 500
      }
    }
  ]
}
{% endschema %}
