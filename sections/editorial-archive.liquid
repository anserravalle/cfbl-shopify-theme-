<style>
  #shopify-section-{{ section.id }} .editorial-archive {
    background: var(--musa-parchment);
    padding: var(--space-9) 0;
  }

  #shopify-section-{{ section.id }} .editorial-archive__inner {
    max-width: var(--container-text);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  #shopify-section-{{ section.id }} .editorial-archive__head {
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--musa-rule);
    padding-bottom: var(--space-6);
  }

  #shopify-section-{{ section.id }} .editorial-archive__label {
    font-family: var(--musa-font-utility);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--musa-walnut);
    margin: 0 0 var(--space-3);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .editorial-archive__heading {
    font-family: var(--musa-font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--musa-ink);
    letter-spacing: -0.005em;
    line-height: 1.1;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .editorial-archive__description {
    font-family: var(--musa-font-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--musa-ink);
    margin: var(--space-4) 0 0;
    opacity: 0.8;
  }

  /* Filters */
  #shopify-section-{{ section.id }} .editorial-archive__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--musa-rule);
  }

  #shopify-section-{{ section.id }} .filter-btn {
    font-family: var(--musa-font-utility);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--musa-walnut);
    background: none;
    border: 1px solid var(--musa-rule);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .filter-btn:hover,
  #shopify-section-{{ section.id }} .filter-btn[aria-pressed="true"] {
    background: var(--musa-walnut);
    color: var(--musa-bone);
    border-color: var(--musa-walnut);
  }

  /* Essay list */
  #shopify-section-{{ section.id }} .essay-archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .essay-archive-item {
    border-top: 1px solid var(--musa-ochre);
    padding: var(--space-6) 0;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-5);
  }

  #shopify-section-{{ section.id }} .essay-archive-item__num {
    font-family: var(--musa-font-utility);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--musa-walnut);
    padding-top: 6px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .essay-archive-item__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  #shopify-section-{{ section.id }} .essay-archive-item__date {
    font-family: var(--musa-font-utility);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--musa-walnut);
    margin: 0;
    line-height: 1;
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .essay-archive-item__title {
    font-family: var(--musa-font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    font-weight: 400;
    color: var(--musa-ink);
    letter-spacing: -0.005em;
    line-height: 1.15;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .essay-archive-item__title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .essay-archive-item__title a:hover {
    color: var(--musa-oxblood);
  }

  #shopify-section-{{ section.id }} .essay-archive-item__lede {
    font-family: var(--musa-font-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--musa-ink);
    opacity: 0.85;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .essay-archive-item__meta {
    font-family: var(--musa-font-utility);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--musa-walnut);
    opacity: 0.6;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .essay-archive-item__read {
    font-family: var(--musa-font-utility);
    font-size: 0.875rem;
    color: var(--musa-oxblood);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    align-self: flex-start;
    margin-top: var(--space-1);
    transition: color var(--dur-fast) var(--ease);
  }

  #shopify-section-{{ section.id }} .essay-archive-item__read:hover {
    color: var(--musa-walnut);
  }

  @media (max-width: 500px) {
    #shopify-section-{{ section.id }} .essay-archive-item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    #shopify-section-{{ section.id }} .essay-archive-item__num {
      display: none;
    }
  }

  {% render 'section-frame', section: section, brand: 'musa' %}
</style>

<section class="editorial-archive brand-musa" aria-labelledby="archive-heading-{{ section.id }}">
  <div class="editorial-archive__inner">
    <div class="editorial-archive__head">
      <p class="editorial-archive__label">Archive</p>
      {%- if section.settings.heading != blank -%}
        <h2 class="editorial-archive__heading" id="archive-heading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="editorial-archive__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_filters -%}
      <div class="editorial-archive__filters" role="group" aria-label="Filter essays">
        <button class="filter-btn" type="button" aria-pressed="true" data-filter="all">All</button>
        <button class="filter-btn" type="button" aria-pressed="false" data-filter="2026">2026</button>
        <button class="filter-btn" type="button" aria-pressed="false" data-filter="2025">2025</button>
        <button class="filter-btn" type="button" aria-pressed="false" data-filter="2024">2024</button>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="essay-archive-list" role="list">
        {%- for block in section.blocks -%}
          <li
            class="essay-archive-item"
            data-year="{{ block.settings.date | split: ' ' | last }}"
            {{ block.shopify_attributes }}
          >
            <div class="essay-archive-item__num" aria-hidden="true">
              No.&nbsp;{{ section.blocks.size | minus: forloop.index0 | prepend: '0' | slice: -2, 2 }}
            </div>
            <div class="essay-archive-item__body">
              {%- if block.settings.date != blank -%}
                <p class="essay-archive-item__date">
                  <time>{{ block.settings.date | escape }}</time>
                </p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="essay-archive-item__title">
                  {%- if block.settings.url != blank -%}
                    <a href="{{ block.settings.url }}">{{ block.settings.title | escape }}</a>
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </h3>
              {%- endif -%}
              {%- if block.settings.lede != blank -%}
                <p class="essay-archive-item__lede">{{ block.settings.lede }}</p>
              {%- endif -%}
              {%- if block.settings.read_time != blank -%}
                <p class="essay-archive-item__meta">{{ block.settings.read_time | escape }}</p>
              {%- endif -%}
              {%- if block.settings.url != blank -%}
                <a href="{{ block.settings.url }}" class="essay-archive-item__read" aria-label="Read {{ block.settings.title | escape }}">
                  Read &#8594;
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.show_filters -%}
<script>
  (function () {
    var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    var filterBtns = sectionEl.querySelectorAll('.filter-btn');
    var items = sectionEl.querySelectorAll('.essay-archive-item');

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var filter = this.dataset.filter;

        filterBtns.forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
        this.setAttribute('aria-pressed', 'true');

        items.forEach(function (item) {
          if (filter === 'all' || item.dataset.year === filter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
