<style>
  .brand-intro {
    padding: var(--space-9) 0;
  }

  .brand-intro__inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    text-align: center;
  }

  .brand-intro__logo {
    margin: 0 auto var(--space-5);
    max-width: 140px;
    height: auto;
    display: block;
  }

  .brand-intro__rule {
    width: 40px;
    height: 1px;
    margin: 0 auto var(--space-5);
    border: none;
  }

  .brand-cfbl    .brand-intro__rule { background: var(--cfbl-terracotta); }
  .brand-institute .brand-intro__rule { background: var(--inst-forest); }
  .brand-musa    .brand-intro__rule { background: var(--musa-ochre); }

  .brand-intro__label {
    font-family: var(--cfbl-font-body);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin: 0 0 var(--space-3);
    font-weight: 600;
  }

  .brand-cfbl    .brand-intro__label { color: var(--cfbl-terracotta); font-family: var(--cfbl-font-body); }
  .brand-institute .brand-intro__label { color: var(--inst-forest); font-family: var(--inst-font-utility); }
  .brand-musa    .brand-intro__label { color: var(--musa-walnut); font-family: var(--musa-font-utility); }

  .brand-intro__heading {
    margin: 0 0 var(--space-5);
  }

  .brand-intro__description {
    margin: 0 0 var(--space-6);
    max-width: 44ch;
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }

  /* DYNAMIC SECTION OVERRIDES */
  {%- liquid
    assign pt = section.settings.padding_top | default: 'medium'
    assign pb = section.settings.padding_bottom | default: 'medium'
    if pt == 'none'
      assign pt_val = '0'
    elsif pt == 'small'
      assign pt_val = 'var(--space-6)'
    elsif pt == 'large'
      assign pt_val = 'var(--space-11)'
    elsif pt == 'xl'
      assign pt_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pt_val = 'var(--space-9)'
    endif
    if pb == 'none'
      assign pb_val = '0'
    elsif pb == 'small'
      assign pb_val = 'var(--space-6)'
    elsif pb == 'large'
      assign pb_val = 'var(--space-11)'
    elsif pb == 'xl'
      assign pb_val = 'calc(var(--space-11) * 1.5)'
    else
      assign pb_val = 'var(--space-9)'
    endif
    assign hs = section.settings.heading_size | default: 'md'
    if hs == 'sm'
      assign hs_scale = '0.8'
    elsif hs == 'lg'
      assign hs_scale = '1.2'
    elsif hs == 'xl'
      assign hs_scale = '1.45'
    else
      assign hs_scale = '1'
    endif
  -%}
  {%- if section.settings.section_bg != blank -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.section_bg }} !important; }
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div { background: {{ section.settings.section_bg }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} > section,
  #shopify-section-{{ section.id }} > div:first-child {
    padding-top: {{ pt_val }} !important;
    padding-bottom: {{ pb_val }} !important;
  }
  {%- if section.settings.text_align == 'center' -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p { text-align: center; }
  {%- endif -%}
  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 { font-size: calc(1em * {{ hs_scale }}); }
</style>

{% liquid
  assign brand = section.settings.brand | default: 'cfbl'
  assign show_logo = section.settings.show_logo
%}

<section class="brand-intro brand-{{ brand }}" id="section-{{ section.id }}">
  <div class="brand-intro__inner">
    {% if show_logo and section.settings.logo != blank %}
      <img
        src="{{ section.settings.logo | image_url: width: 280 }}"
        alt="{{ section.settings.logo.alt | escape }}"
        class="brand-intro__logo"
        width="140"
        height="{{ 140 | divided_by: section.settings.logo.aspect_ratio | round }}"
        loading="lazy"
      >
    {% endif %}

    <hr class="brand-intro__rule" aria-hidden="true">

    {% if section.settings.label != blank %}
      <p class="brand-intro__label">{{ section.settings.label }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="brand-intro__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="brand-intro__description">{{ section.settings.description }}</p>
    {% endif %}

    {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
      <a href="{{ section.settings.cta_url }}" class="btn btn-primary">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Brand Introduction",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "brand",
      "label": "Brand context",
      "options": [
        {
          "value": "cfbl",
          "label": "Center for Balanced Living"
        },
        {
          "value": "institute",
          "label": "CFBL Institute"
        },
        {
          "value": "musa",
          "label": "MUSA"
        }
      ],
      "default": "cfbl"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "info": "Leave blank to use the brand default background."
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading & text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left (default)"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium (default)"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Brand Introduction",
      "settings": {
        "brand": "institute",
        "show_logo": true,
        "label": "CFBL Institute",
        "heading": "Continuing education for licensed clinicians",
        "description": "Trainings in trauma-based practice, psychological assessment, and applied clinical reasoning. Taught by a practicing psychologist.",
        "cta_label": "View Trainings",
        "cta_url": "/pages/cfbl-institute"
      }
    }
  ]
}
{% endschema %}