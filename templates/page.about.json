        "richtext_emei3C": {
          "type": "richtext",
          "settings": {
            "paragraph_class_name": "richtext-p-section",
            "content": "<h6>Balance of Mind, Body & Spirit</h6><p><em>Center for Balanced Living is a trauma-informed psychological practice in Townsend, Delaware, offering therapy, psychological evaluations, supervision, consultation, and educational programming. </em></p><p><em>Our work is grounded in nervous system awareness, somatic processing, relational attunement, and evidence-based care. </em></p><p><em>We believe healing happens in relationship and that every person deserves support that is thoughtful, individualized, and responsive to where they are in the process.</em></p>"
          }
        }
      },
