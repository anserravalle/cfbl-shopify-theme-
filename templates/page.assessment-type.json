    "rich_text_iqJ9kj": {
      "type": "rich-text",
      "blocks": {
        "heading_qpFQwy": {
          "type": "heading",
          "settings": {
            "text": "What a Psychological Evaluation Can Provide",
            "heading_tag": "h3",
            "text_color": "",
            "gradient": ""
          }
        },
        "richtext_YPUUga": {
          "type": "richtext",
          "settings": {
            "paragraph_class_name": "richtext-p-section",
            "content": "<p>A psychological evaluation can help clarify patterns that may not be fully understood through conversation alone. By integrating clinical interview data, behavioral observations, standardized testing, rating scales, and collateral information when appropriate, the evaluation process provides a more complete picture of strengths, vulnerabilities, and diagnostic considerations.</p>"
          }
        }
      },
