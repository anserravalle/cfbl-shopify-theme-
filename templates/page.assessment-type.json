            "gradient": ""
          }
        },
        "richtext_C4cfCH": {
          "type": "richtext",
          "settings": {
            "paragraph_class_name": "richtext-p-section",
            "content": "<p>Evaluations may be helpful for children, adolescents, and adults when there are concerns about attention, learning, emotional functioning, behavior, personality, autism, or diagnostic uncertainty. </p><p>They can also be useful when previous questions have gone unanswered or when a more complete understanding is needed to guide support and recommendations.</p><p><strong>An evaluation may be helpful for concerns such as:</strong></p>"
          }
        },
        "liquid_tcQb8w": {
          "type": "liquid",
          "settings": {
            "liquid": "<ul class=\"service-list\">\n  <li>Attention and executive functioning concerns</li>\n  <li>Learning and academic difficulties</li>\n  <li>Autism-related questions</li>\n  <li>Diagnostic clarification</li>\n  <li>Emotional and behavioral concerns</li>\n  <li>Personality and relational functioning</li>\n  <li>Mood and anxiety-related symptoms</li>\n  <li>Developmental concerns</li>\n  <li>Treatment planning needs</li>\n  <li>School or accommodation recommendations</li>\n</ul>"
          }
        }
      },
