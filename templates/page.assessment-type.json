    "custom_liquid_iNUXi6": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<section class=\"personality-eval-info\">\n  <div class=\"personality-eval-wrap\">\n\n    <div class=\"personality-eval-card\">\n      <h3>What this type of evaluation may help clarify</h3>\n      <p>\n        This evaluation may be appropriate when there are questions related to mood, anxiety, trauma, emotional regulation, personality functioning, interpersonal patterns, self-esteem, identity, coping strategies, or diagnostic clarification. It may also be useful when someone has been in therapy but feels stuck, has received different diagnoses over time, or wants a more complete picture of their emotional and psychological functioning.\n      </p>\n    </div>\n\n    <div class=\"personality-eval-card\">\n      <h3>Who may benefit</h3>\n      <p>\n        Adults or older adolescents may benefit from this type of evaluation when they are seeking greater clarity about emotional distress, relationship patterns, trauma-related symptoms, personality traits, or treatment direction. It may also be helpful for therapists, physicians, or other referral sources who are seeking diagnostic clarity to guide treatment planning.\n      </p>\n    </div>\n\n    <div class=\"personality-eval-card\">\n      <h3>What to expect</h3>\n      <p>\n        The evaluation typically includes a clinical interview, review of relevant history, standardized psychological measures, and an integrated written report. Recommendations may include diagnostic impressions, treatment considerations, therapy approaches that may be helpful, and next steps for care.\n      </p>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .personality-eval-info {\n    width: 100%;\n    padding: 40px 0;\n    background-color: transparent;\n  }\n\n  .personality-eval-wrap {\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 0 20px;\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 22px;\n  }\n\n  .personality-eval-card {\n    background-color: #F6F3ED;\n    border: 1px solid rgba(43, 82, 117, 0.18);\n    border-radius: 18px;\n    padding: 28px;\n  }\n\n  .personality-eval-card h3 {\n    margin: 0 0 14px;\n    font-family: 'Spectral SC', serif;\n    font-size: 28px;\n    line-height: 1.25;\n    font-weight: 300;\n    color: #2B5275;\n  }\n\n  .personality-eval-card p {\n    margin: 0;\n    font-family: Montserrat, sans-serif;\n    font-size: 16px;\n    line-height: 1.8;\n    color: #3D2D29;\n  }\n\n  @media screen and (min-width: 850px) {\n    .personality-eval-wrap {\n      grid-template-columns: repeat(3, 1fr);\n      align-items: stretch;\n    }\n\n    .personality-eval-card {\n      padding: 30px;\n    }\n\n    .personality-eval-card h3 {\n      font-size: 25px;\n    }\n  }\n\n  @media screen and (max-width: 600px) {\n    .personality-eval-info {\n      padding: 28px 0;\n    }\n\n    .personality-eval-card {\n      padding: 24px;\n      border-radius: 16px;\n    }\n\n    .personality-eval-card h3 {\n      font-size: 24px;\n    }\n\n    .personality-eval-card p {\n      font-size: 15px;\n      line-height: 1.75;\n    }\n  }\n</style>",
        "background": "#93ced7",
        "background_gradient": "",
        "text_color": ""
      }
