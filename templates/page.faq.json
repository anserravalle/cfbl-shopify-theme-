      "blocks": {
        "richtext_hCQn3H": {
          "type": "richtext",
          "settings": {
            "paragraph_class_name": "richtext-p-section",
            "content": "<h2>Still Have Questions?</h2><p>Whether you're seeking therapy, evaluations, consultations, or training, our dedicated team is here to support your journey toward well-being.</p><p>For immediate service please call our office.</p><h3>Call: (302) 608-3780</h3><p>Alternatively, our contact form is available for your convenience.</p><p>We typically respond within 24 hours.</p>"
          }
        },
