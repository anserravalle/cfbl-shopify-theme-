      "type": "accordion-content",
      "blocks": {
        "item_y3HCdt": {
          "type": "item",
          "settings": {
            "title": "Who is supervision available for?",
            "content": "<p><em>Supervision at Center for Balanced Living is available for LPC associates and PsyD trainees working toward licensure as mental health counselors and psychologists. If you are accumulating supervised hours toward licensure, this is the right fit.</em></p>"
          }
        },
        "item_zVyR7m": {
          "type": "item",
          "settings": {
            "title": "What does supervision focus on?",
            "content": "<p><em>Supervision integrates case conceptualization, trauma-informed treatment planning, ethical decision making, and the development of clinical judgment. Sessions support both practical skill development and the theoretical integration that strong clinical practice requires.</em></p>"
          }
        },
        "item_qjM63a": {
          "type": "item",
          "settings": {
            "title": "How do I get started with supervision?",
            "content": "<p><em>Reach out through our contact form or call (302) 608-3780 and someone from our office will be in touch within 24 hours to discuss your supervision needs and goals.</em></p>"
          }
        }
      },
      "block_order": [
