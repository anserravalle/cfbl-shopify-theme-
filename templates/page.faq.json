      "blocks": {
        "item_qHHbnj": {
          "type": "item",
          "settings": {
            "title": "Who are the wellness groups for?",
            "content": "<p><em>Our wellness groups are open to adults and teens 16 and up who are seeking personal growth, nervous system regulation skills, and connection in a supportive community setting. </em></p><p><em>Groups are educational and experiential in nature, not therapy groups, and are not covered by insurance.</em></p>"
          }
        },
        "item_UWC4dF": {
          "type": "item",
          "settings": {
            "title": "Do I need to be in therapy to join a group?",
            "content": "<p><em>No. Our wellness groups are open to community members whether or not you are currently in therapy. </em></p><p><em>They are designed to be accessible and valuable as a standalone experience or as a complement to individual therapy.</em></p>"
          }
        },
        "item_LmfB8k": {
          "type": "item",
          "settings": {
            "title": "How do I sign up for a group?",
            "content": "<p><em>Each group has its own registration through Eventbrite. </em><a href=\"https://www.eventbrite.com/o/center-for-balanced-living-121062482552\" target=\"_blank\" title=\"https://www.eventbrite.com/o/center-for-balanced-living-121062482552\"><em>(CLICK HERE)</em></a></p><p><em>Visit the Groups page to see current offerings and available dates. </em></p><p><em>Advance registration is required as group sizes are intentionally small. </em></p><p><em>Reach out to our office at (302) 608-3780 with any questions.</em></p>"
          }
        }
      },
