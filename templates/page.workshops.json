    "custom_liquid_qGGCph": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<!-- =====================================================\n     SECTION: AREAS OF TRAINING (primary content block)\n     Replaces the existing bullet list of training areas.\n     Place directly under the page intro, above Our Approach.\n     ===================================================== -->\n\n<section style=\"background-color: #b8c9bc; padding: 72px 20px 56px 20px;\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n\n    <h2 style=\"font-size: 1.875rem; color: #2a3530; text-align: center; margin: 0 0 14px 0;\">Areas of Training</h2>\n    <p style=\"font-size: 1.0625rem; line-height: 1.65; color: #4a5a52; text-align: center; max-width: 680px; margin: 0 auto 56px auto;\">\n      CFBL Institute develops continuing education across six clinical domains. Offerings rotate throughout the year. Join the mailing list to be notified as new trainings open for registration.\n    </p>\n\n    <div style=\"display: flex; flex-wrap: wrap; gap: 28px; justify-content: center; align-items: stretch;\">\n\n      <!-- Card 1: Trauma Therapy -->\n      <div style=\"flex: 1 1 320px; max-width: 340px; background-color: #f0eae0; border-left: 3px solid #3d5a52; display: flex; flex-direction: column;\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0861/1528/7346/files/nature_based.jpg?v=1779752916\" alt=\"Layered river stones along a still shoreline, banner image for CFBL Institute trauma therapy continuing education.\" style=\"width: 100%; height: 240px; object-fit: cover; display: block;\">\n        <div style=\"padding: 22px 26px 28px 26px;\">\n          <p style=\"font-size: 0.75rem; color: #3d5a52; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 10px 0;\">Clinical Domain</p>\n          <h3 style=\"font-size: 1.3125rem; color: #2a3530; margin: 0 0 12px 0;\">Trauma Therapy</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.65; color: #4a5a52; margin: 0;\">\n            Continuing education in trauma-focused care, stabilization, and the integration of evidence-based modalities for complex presentations.\n          </p>\n        </div>\n      </div>\n\n      <!-- Card 2: Nature-Informed EMDR -->\n      <div style=\"flex: 1 1 320px; max-width: 340px; background-color: #f0eae0; border-left: 3px solid #3d5a52; display: flex; flex-direction: column;\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0861/1528/7346/files/IMG_0060.png?v=1779655181\" alt=\"Sunlight through pine forest along a quiet path, banner image for the CFBL Institute Nature-Informed EMDR workshop.\" style=\"width: 100%; height: 240px; object-fit: cover; display: block;\">\n        <div style=\"padding: 22px 26px 28px 26px;\">\n          <p style=\"font-size: 0.75rem; color: #3d5a52; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 10px 0;\">Advanced EMDR</p>\n          <h3 style=\"font-size: 1.3125rem; color: #2a3530; margin: 0 0 12px 0;\">Nature-Informed EMDR</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.65; color: #4a5a52; margin: 0;\">\n            Advanced workshops for EMDR-trained clinicians on the disciplined integration of nature-informed considerations within standard EMDR practice.\n          </p>\n        </div>\n      </div>\n\n      <!-- Card 3: Psychological Assessment -->\n      <div style=\"flex: 1 1 320px; max-width: 340px; background-color: #f0eae0; border-left: 3px solid #3d5a52; display: flex; flex-direction: column;\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0861/1528/7346/files/IMG_5840.jpg?v=1779658778\" alt=\"Pressed botanical specimen on cream paper, banner image for CFBL Institute psychological assessment training.\" style=\"width: 100%; height: 240px; object-fit: cover; display: block;\">\n        <div style=\"padding: 22px 26px 28px 26px;\">\n          <p style=\"font-size: 0.75rem; color: #3d5a52; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 10px 0;\">Clinical Domain</p>\n          <h3 style=\"font-size: 1.3125rem; color: #2a3530; margin: 0 0 12px 0;\">Psychological Assessment</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.65; color: #4a5a52; margin: 0;\">\n            Training in diagnostic precision, integrative case conceptualization, and the disciplined use of psychological testing in clinical practice.\n          </p>\n        </div>\n      </div>\n\n      <!-- Card 4: Somatic and Nervous System -->\n      <div style=\"flex: 1 1 320px; max-width: 340px; background-color: #f0eae0; border-left: 3px solid #3d5a52; display: flex; flex-direction: column;\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0861/1528/7346/files/IMG_5841.jpg?v=1779658834\" alt=\"Folds of natural linen in soft window light, banner image for CFBL Institute somatic and nervous system training.\" style=\"width: 100%; height: 240px; object-fit: cover; display: block;\">\n        <div style=\"padding: 22px 26px 28px 26px;\">\n          <p style=\"font-size: 0.75rem; color: #3d5a52; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 10px 0;\">Clinical Domain</p>\n          <h3 style=\"font-size: 1.3125rem; color: #2a3530; margin: 0 0 12px 0;\">Somatic and Nervous System</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.65; color: #4a5a52; margin: 0;\">\n            Continuing education on nervous system regulation, somatic awareness, and the body's role in trauma-focused clinical work.\n          </p>\n        </div>\n      </div>\n\n      <!-- Card 5: Ethics and Clinical Reasoning -->\n      <div style=\"flex: 1 1 320px; max-width: 340px; background-color: #f0eae0; border-left: 3px solid #3d5a52; display: flex; flex-direction: column;\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0861/1528/7346/files/IMG_5842.webp?v=1779658777\" alt=\"Empty chair in morning window light, banner image for CFBL Institute ethics and clinical decision-making training.\" style=\"width: 100%; height: 240px; object-fit: cover; display: block;\">\n        <div style=\"padding: 22px 26px 28px 26px;\">\n          <p style=\"font-size: 0.75rem; color: #3d5a52; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 10px 0;\">Clinical Domain</p>\n          <h3 style=\"font-size: 1.3125rem; color: #2a3530; margin: 0 0 12px 0;\">Ethics and Clinical Reasoning</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.65; color: #4a5a52; margin: 0;\">\n            Continuing education on ethical clinical reasoning, scope of practice, and structured case decision-making for licensed clinicians.\n          </p>\n        </div>\n      </div>\n\n      <!-- Card 6: Group Facilitation -->\n      <div style=\"flex: 1 1 320px; max-width: 340px; background-color: #f0eae0; border-left: 3px solid #3d5a52; display: flex; flex-direction: column;\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0861/1528/7346/files/IMG_5844.jpg?v=1779658843\" alt=\"Ceramic cups arranged on a wooden table, banner image for CFBL Institute group therapy facilitation training.\" style=\"width: 100%; height: 240px; object-fit: cover; display: block;\">\n        <div style=\"padding: 22px 26px 28px 26px;\">\n          <p style=\"font-size: 0.75rem; color: #3d5a52; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 10px 0;\">Clinical Domain</p>\n          <h3 style=\"font-size: 1.3125rem; color: #2a3530; margin: 0 0 12px 0;\">Group Facilitation</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.65; color: #4a5a52; margin: 0;\">\n            Continuing education on group therapy facilitation, relational dynamics, and the clinical structure of healing in community.\n          </p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
