        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<!-- ============================================\n     PROFESSIONAL TRAINING: SPECIALTY AREAS\n     ============================================ -->\n\n<section style=\"padding: 80px 20px; margin: 32px 0; background-color: #ede0c8; border-top: 1px solid #d4c5b9; border-bottom: 1px solid #d4c5b9;\">\n  <div style=\"max-width: 1180px; margin: 0 auto;\">\n\n    <p style=\"font-size: 0.75rem; color: #8b6f5c; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 14px 0; text-align: center; font-weight: 600;\">From CFBL Institute</p>\n\n    <h2 style=\"font-size: 2rem; color: #3a342e; text-align: center; margin: 0 0 20px 0; line-height: 1.2;\">Advanced Training for Practicing Clinicians</h2>\n\n    <p style=\"font-size: 1.0625rem; line-height: 1.7; color: #4a443e; text-align: center; max-width: 700px; margin: 0 auto 64px auto;\">\n      Continuing education for psychologists, therapists, and counselors who are already doing the work and want to do it more skillfully. Each training is built from current research and shaped by years of direct clinical practice, with formats that include intensives, consultation cohorts, guest expert sessions, and community-based events.\n    </p>\n\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px;\">\n\n\n      <!-- CARD 1: TRAUMA-INFORMED PRACTICE -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 200px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/somatic.jpg?v=1779759843');\" data-image=\"trauma-informed-practice\">\n        </div>\n        <div style=\"padding: 28px;\">\n          <p style=\"font-size: 0.7rem; color: #8b6f5c; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 10px 0; font-weight: 600;\">Specialty Area</p>\n          <h3 style=\"font-size: 1.25rem; color: #3a342e; margin: 0 0 12px 0; line-height: 1.25;\">Trauma-Informed Practice</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.6; color: #4a443e; margin: 0;\">\n            Integrating nervous system awareness, somatic responsiveness, and relational safety into evidence-based clinical care.\n          </p>\n        </div>\n      </div>\n\n\n      <!-- CARD 2: PSYCHOLOGICAL EVALUATION -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 200px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/Psychological_Evaluation_Diagnostic_Clarity.jpg?v=1779759842');\" data-image=\"psychological-evaluation\">\n        </div>\n        <div style=\"padding: 28px;\">\n          <p style=\"font-size: 0.7rem; color: #8b6f5c; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 10px 0; font-weight: 600;\">Specialty Area</p>\n          <h3 style=\"font-size: 1.25rem; color: #3a342e; margin: 0 0 12px 0; line-height: 1.25;\">Psychological Evaluation &amp; Diagnostic Clarity</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.6; color: #4a443e; margin: 0;\">\n            Sharpening diagnostic reasoning, integrating test data with clinical history, and writing reports that drive treatment.\n          </p>\n        </div>\n      </div>\n\n\n      <!-- CARD 3: EMDR -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 200px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/EMDR_Trauma-Focused_Work.webp?v=1779759842');\" data-image=\"emdr\">\n        </div>\n        <div style=\"padding: 28px;\">\n          <p style=\"font-size: 0.7rem; color: #8b6f5c; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 10px 0; font-weight: 600;\">Specialty Area</p>\n          <h3 style=\"font-size: 1.25rem; color: #3a342e; margin: 0 0 12px 0; line-height: 1.25;\">EMDR &amp; Trauma-Focused Work</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.6; color: #4a443e; margin: 0;\">\n            Advanced application of EMDR protocols, complex trauma presentations, and the clinical judgment that holds both.\n          </p>\n        </div>\n      </div>\n\n\n      <!-- CARD 4: CLINICAL CONSULTATION -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 200px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/vitaly-gariev-ak1UP0hIK28-unsplash.jpg?v=1779759865');\" data-image=\"clinical-consultation\">\n        </div>\n        <div style=\"padding: 28px;\">\n          <p style=\"font-size: 0.7rem; color: #8b6f5c; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 10px 0; font-weight: 600;\">Specialty Area</p>\n          <h3 style=\"font-size: 1.25rem; color: #3a342e; margin: 0 0 12px 0; line-height: 1.25;\">Clinical Consultation &amp; Case Conceptualization</h3>\n          <p style=\"font-size: 0.9375rem; line-height: 1.6; color: #4a443e; margin: 0;\">\n            Building case formulations that hold complexity. Refining the questions you ask and the hypotheses you test.\n          </p>\n        </div>\n      </div>\n\n\n     \n    </div>\n\n\n    <!-- FOOTER NOTE + CTA -->\n    <div style=\"text-align: center; margin-top: 64px; padding-top: 40px; border-top: 1px solid #d4c5b9;\">\n      <p style=\"font-size: 0.9375rem; line-height: 1.65; color: #6a635a; max-width: 620px; margin: 0 auto 28px auto; font-style: italic;\">\n        Trainings are offered as intensives, ongoing consultation cohorts, and select community-based events. CE eligibility varies by offering.\n      </p>\n      <a href=\"/pages/contact\" style=\"display: inline-block; background-color: #8b6f5c; color: #ffffff; padding: 14px 32px; text-decoration: none; font-size: 0.9375rem; letter-spacing: 0.05em;\">Inquire About Training</a>\n    </div>\n\n  </div>\n</section>",
        "background": "#f2f2f2",
        "background_gradient": "",
        "text_color": ""
      }
    },
