    "text_with_icons_n4bDT4": {
      "type": "text-with-icons",
      "blocks": {
        "item_KETj8d": {
          "type": "item",
          "settings": {
            "icon": "picto-chat",
            "custom_icon": "shopify://shop_images/flexibletherapyIcon.svg",
            "mobile_icon_width": 52,
            "icon_width": 52,
            "icon_background_type": "circle",
            "icon_background": "#ece5e1",
            "icon_color": "#389fbc",
            "title": "",
            "content": "<h4>Flexible Therapy <br/>Modes</h4><p>Offering both in-office and online therapy sessions, we ensure accessibility and convenience to fit your lifestyle. Whether you prefer the personal touch of face-to-face sessions or the flexibility of online consultations, our service adapts to meet your needs.</p>"
          }
        },
        "item_gfNz7N": {
          "type": "item",
          "settings": {
            "icon": "picto-credit-card",
            "custom_icon": "shopify://shop_images/insurance-cashpay.svg",
            "mobile_icon_width": 52,
            "icon_width": 52,
            "icon_background_type": "circle",
            "icon_background": "#ece5e1",
            "icon_color": "#389fbc",
            "title": "",
            "content": "<h4>Multiple Payment <br/>Options</h4><p>Understanding the importance of mental health care, we provide various payment options including insurance billing, cash payments, and CareCredit plans. Our goal is to make therapy accessible, ensuring that financial constraints do not hinder your path to wellness.</p>"
          }
        },
        "item_8rM3Wz": {
          "type": "item",
          "settings": {
            "icon": "picto-secure-profile",
            "custom_icon": "shopify://shop_images/groupUserIcon.svg",
            "mobile_icon_width": 52,
            "icon_width": 52,
            "icon_background_type": "circle",
            "icon_background": "#ece5e1",
            "icon_color": "#389fbc",
            "title": "",
            "content": "<h4>Personal & Group Sessions</h4><p>Our services are designed to cater to both individual preferences and the dynamics of group therapy. Whether seeking personalized care or the shared experiences of group sessions, our therapy programs are tailored to support your journey to healing in a setting that feels right for you.</p>"
          }
        }
      },
