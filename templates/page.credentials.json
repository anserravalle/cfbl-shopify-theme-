      "settings": {
        "section_class_name": "theme-creds",
        "blockId": "",
        "full_width": true,
        "stack_on_mobile": true,
        "gap": "small",
        "text_alignment": "center",
        "subheading": "",
        "title": "",
        "content": "<h3>Our Credentials</h3><p>Our work is grounded in advanced training in trauma treatment, psychological evaluation, and integrative clinical care. We draw from evidence-based and experiential approaches to provide individualized treatment that is both clinically rigorous and responsive to the needs of each client.</p>",
        "background": "rgba(0,0,0,0)",
