    "rich_text_7VhY8f": {
      "type": "rich-text",
      "blocks": {
        "heading_bejdpF": {
          "type": "heading",
          "settings": {
            "text": "Core Clinical Credentials",
            "heading_tag": "h3",
            "text_color": "",
            "gradient": ""
          }
        },
        "richtext_tMn3bY": {
          "type": "richtext",
          "settings": {
            "paragraph_class_name": "richtext-p-section",
            "content": "<p><strong>EMDR Certified Therapist</strong><br/>Advanced training in Eye Movement Desensitization and Reprocessing to support the processing of trauma and other distressing experiences.</p><p><strong>Trauma-Focused Cognitive Behavioral Therapy (TF-CBT)</strong><br/>Evidence-based treatment for children and adolescents impacted by trauma, with a structured framework that supports symptom reduction and recovery.</p><p><strong>Extensive Training in Dialectical Behavior Therapy (DBT)</strong><br/>Structured behavioral approach supporting emotion regulation, distress tolerance, interpersonal effectiveness, and mindfulness.</p><p><strong>Acceptance and Commitment Therapy (ACT)</strong></p><p>Supports psychological flexibility and values-based action, particularly when clients feel stuck in patterns of avoidance or distress.</p><p><strong>Ecotherapy </strong></p><p>Integrates nature-based interventions to support reflection, regulation, and overall wellbeing.</p>"
          }
        }
      },
