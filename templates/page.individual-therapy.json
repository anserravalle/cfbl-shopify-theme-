        "liquid": "<!-- ============================================\n     INDIVIDUAL THERAPY: AREAS OF CARE\n     =========================================== -->\n\n<section style=\"padding: 80px 20px; margin: 48px 0; background-color: #d9e3d4 ; border-top: 1px solid #d4c5b9; border-bottom: 1px solid #d4c5b9;\">\n  \n<div style=\"max-width: 1320px; margin-left: auto; margin-right: auto; width: 100%; box-sizing: border-box;\">\n\n    <p style=\"font-size: 0.75rem; color: #8b6f5c; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 14px 0; text-align: center; font-weight: 600;\">Individual Therapy</p>\n\n    <h2 style=\"font-size: 2rem; color: #3a342e; text-align: center; margin: 0 0 20px 0; line-height: 1.2;\">Areas of Care</h2>\n\n    <p style=\"font-size: 1.0625rem; line-height: 1.7; color: #4a443e; text-align: center; max-width: 660px; margin: 0 auto 56px auto;\">\n      The presentations we most often work with. Each one shows up differently in different people. The work is shaped to you.\n    </p>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 280px)); gap: 24px; justify-content: center;\">\n\n      <!-- CARD 1: TRAUMA AND TRAUMATIC STRESS - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/nature2.avif?v=1779761361');\" data-image=\"trauma\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Trauma and Traumatic Stress</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 2: ANXIETY AND CHRONIC WORRY - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/natrure_1212.avif?v=1779762293');\" data-image=\"anxiety\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Anxiety and Chronic Worry</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 3: DEPRESSION AND MOOD CHANGES - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/nature_10.avif?v=1779761467');\" data-image=\"depression\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Depression and Mood Changes</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 4: GRIEF AND LOSS - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/nature_11.avif?v=1779761467');\" data-image=\"grief\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Grief and Loss</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 5: RELATIONSHIP AND FAMILY STRESS - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/nature_4.avif?v=1779761361');\" data-image=\"relationships\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Relationship and Family Stress</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 6: LIFE TRANSITIONS - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/ture_9.avif?v=1779761361');\" data-image=\"life-transitions\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Life Transitions</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 7: IDENTITY DEVELOPMENT - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/re_5.avif?v=1779761361');\" data-image=\"identity\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Identity Development</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 8: EMOTIONAL REGULATION - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/nature_6.avif?v=1779761361');\" data-image=\"emotional-regulation\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Emotional Regulation Difficulties</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 9: PARENTING SUPPORT - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/ure_3.avif?v=1779761360');\" data-image=\"parenting\">\n        </div>\n        <div style=\"padding: 20px 22px; min-height: 84px;\">\n          <h3 style=\"font-size: 1.0625rem; color: #3a342e; margin: 0; line-height: 1.3;\">Parenting Support</h3>\n        </div>\n      </div>\n\n\n      <!-- CARD 10: STRESS AND BURNOUT - replace 'none' with your URL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e8dfd6; overflow: hidden; display: flex; flex-direction: column;\">\n        <div style=\"width: 100%; height: 160px; background-color: #ece5e1; background-size: cover; background-position: center; background-image:URL('https://cdn.shopify.com/s/files/1/0861/1528/7346/files/nature_1.jpg?v