0 0 10px;\n    font-family: Montserrat, sans-serif;\n    font-size: 13px;\n    line-height: 1.4;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #9D654E;\n    font-weight: 600;\n  }\n\n  .adhd-expect-card h2 {\n    margin: 0 0 24px;\n    font-family: 'Spectral SC', serif;\n    font-size: 38px;\n    line-height: 1.15;\n    font-weight: 300;\n    color: #2B5275;\n  }\n\n  .adhd-expect-list {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .adhd-expect-item {\n    display: grid;\n    grid-template-columns: 12px 1fr;\n    gap: 14px;\n    align-items: start;\n  }\n\n  .adhd-expect-dot {\n    width: 8px;\n    height: 8px;\n    margin-top: 11px;\n    border-radius: 50%;\n    background-color: #2B5275;\n    display: block;\n  }\n\n  .adhd-expect-item p {\n    margin: 0;\n    font-family: Montserrat, sans-serif;\n    font-size: 16px;\n    line-height: 1.8;\n    color: #3D2D29;\n  }\n\n  @media screen and (max-width: 600px) {\n    .adhd-expect-section {\n      padding: 32px 0;\n    }\n\n    .adhd-expect-card {\n      padding: 28px 24px;\n      border-radius: 20px;\n    }\n\n    .adhd-expect-card h2 {\n      font-size: 31px;\n    }\n\n    .adhd-expect-item p {\n      font-size: 15px;\n      line-height: 1.75;\n    }\n  }\n</style>",
