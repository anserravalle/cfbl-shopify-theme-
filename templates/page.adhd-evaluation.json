        "liquid": "<section class=\"adhd-eval-section\">\n  <div class=\"adhd-eval-container\">\n\n    <div class=\"adhd-eval-intro\">\n      <p class=\"adhd-eval-eyebrow\">ADHD Evaluations</p>\n      <h2>Understanding attention, executive functioning, and daily life demands</h2>\n      <p>\n        ADHD and executive functioning evaluations are designed to clarify patterns of attention, organization, emotional regulation, learning, follow-through, and daily functioning.\n      </p>\n    </div>\n\n    <div class=\"adhd-eval-grid\">\n\n      <div class=\"adhd-eval-card\">\n        <p class=\"adhd-card-label\">Clinical clarity</p>\n        <h3>What this type of evaluation may help clarify</h3>\n        <p>\n          This evaluation may be appropriate when there are questions related to ADHD, attention, impulsivity, hyperactivity, executive functioning, organization, planning, working memory, emotional regulation, academic performance, task initiation, follow-through, or diagnostic clarification.\n        </p>\n        <p>\n          It may also be useful when someone has been described as bright but inconsistent, capable but overwhelmed, unmotivated, forgetful, emotionally reactive, or unable to keep up with daily expectations despite effort.\n        </p>\n      </div>\n\n      <div class=\"adhd-eval-card\">\n        <p class=\"adhd-card-label\">Who this supports</p>\n        <h3>Who may benefit</h3>\n        <p>\n          Children, teens, and adults may benefit from an ADHD evaluation when there are concerns about focus, distractibility, impulsivity, restlessness, disorganization, procrastination, emotional overwhelm, difficulty completing tasks, academic struggles, work performance, or daily functioning.\n        </p>\n        <p>\n          Evaluations may also be helpful for parents, schools, therapists, physicians, or other referral sources seeking diagnostic clarity and individualized recommendations.\n        </p>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .adhd-eval-section {\n    width: 100%;\n    padding: 56px 0;\n    background: linear-gradient(135deg, #F6F3ED 0%, #E5F3F6 100%);\n  }\n\n  .adhd-eval-container {\n    max-width: 1120px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n\n  .adhd-eval-intro {\n    max-width: 780px;\n    margin: 0 auto 34px;\n    text-align: center;\n  }\n\n  .adhd-eval-eyebrow {\n    margin: 0 0 10px;\n    font-family: Montserrat, sans-serif;\n    font-size: 13px;\n    line-height: 1.4;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #9D654E;\n    font-weight: 600;\n  }\n\n  .adhd-eval-intro h2 {\n    margin: 0 0 14px;\n    font-family: 'Spectral SC', serif;\n    font-size: 40px;\n    line-height: 1.16;\n    font-weight: 300;\n    color: #2B5275;\n  }\n\n  .adhd-eval-intro p {\n    margin: 0;\n    font-family: Montserrat, sans-serif;\n    font-size: 16px;\n    line-height: 1.8;\n    color: #3D2D29;\n  }\n\n  .adhd-eval-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n\n  .adhd-eval-card {\n    position: relative;\n    overflow: hidden;\n    background: #FFFFFF;\n    border: 1px solid rgba(43, 82, 117, 0.16);\n    border-radius: 26px;\n    padding: 38px;\n    box-shadow: 0 14px 34px rgba(43, 82, 117, 0.10);\n  }\n\n  .adhd-eval-card::before {\n    content: \"\";\n    position: absolute;\n    top: -70px;\n    right: -70px;\n    width: 170px;\n    height: 170px;\n    border-radius: 50%;\n    background-color: rgba(78, 159, 191, 0.14);\n  }\n\n  .adhd-card-label {\n    margin: 0 0 14px;\n    font-family: Montserrat, sans-serif;\n    font-size: 12px;\n    line-height: 1.4;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #9D654E;\n    font-weight: 600;\n    position: relative;\n    z-index: 1;\n  }\n\n  .adhd-eval-card h3 {\n    margin: 0 0 16px;\n    font-family: 'Spectral SC', serif;\n    font-size: 31px;\n    line-height: 1.18;\n    font-weight: 300;\n    color: #2B5275;\n    position: relative;\n    z-index: 1;\n  }\n\n  .adhd-eval-card p {\n    margin: 0 0 14px;\n    font-family: Montserrat, sans-serif;\n    font-size: 16px;\n    line-height: 1.82;\n    color: #3D2D29;\n    position: relative;\n    z-index: 1;\n  }\n\n  .adhd-eval-card p:last-child {\n    margin-bottom: 0;\n  }\n\n  @media screen and (min-width: 850px) {\n    .adhd-eval-grid {\n      grid-template-columns: repeat(2, 1fr);\n      align-items: stretch;\n    }\n  }\n\n  @media screen and (max-width: 700px) {\n    .adhd-eval-section {\n      padding: 38px 0;\n    }\n\n    .adhd-eval-intro h2 {\n      font-size: 31px;\n    }\n\n    .adhd-eval-card {\n      padding: 30px 24px;\n      border-radius: 22px;\n    }\n\n    .adhd-eval-card h3 {\n      font-size: 26px;\n    }\n\n    .adhd-eval-card p {\n      font-size: 15px;\n      line-height: 1.75;\n    }\n  }\n</style>",
