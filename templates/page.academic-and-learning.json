        "liquid": "<section class=\"learning-expect-section\">\n  <div class=\"learning-expect-container\">\n\n    <div class=\"learning-expect-card\">\n      <p class=\"learning-expect-eyebrow\">Academic and Learning Evaluations</p>\n      <h2>What to expect</h2>\n\n      <div class=\"learning-expect-list\">\n\n        <div class=\"learning-expect-item\">\n          <span class=\"learning-expect-dot\"></span>\n          <p>A clinical interview focused on current academic concerns, developmental history, school functioning, strengths, and evaluation goals.</p>\n        </div>\n\n        <div class=\"learning-expect-item\">\n          <span class=\"learning-expect-dot\"></span>\n          <p>Review of relevant records, which may include school records, prior evaluations, intervention history, report cards, standardized testing, medical information, or collateral information when appropriate.</p>\n        </div>\n\n        <div class=\"learning-expect-item\">\n          <span class=\"learning-expect-dot\"></span>\n          <p>Standardized assessment of cognitive functioning, academic achievement, attention, executive functioning, emotional and behavioral functioning, and other areas as clinically indicated.</p>\n        </div>\n\n        <div class=\"learning-expect-item\">\n          <span class=\"learning-expect-dot\"></span>\n          <p>A feedback session and integrated written report with diagnostic impressions, individualized recommendations, and next steps for school planning, treatment, accommodations, or academic support.</p>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .learning-expect-section {\n    width: 100%;\n    padding: 46px 0;\n    background-color: transparent;\n  }\n\n  .learning-expect-container {\n    max-width: 980px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n\n  .learning-expect-card {\n    background: linear-gradient(135deg, #FFFFFF 0%, #F6F3ED 100%);\n    border: 1px solid rgba(43, 82, 117, 0.16);\n    border-radius: 24px;\n    padding: 38px;\n    box-shadow: 0 14px 34px rgba(43, 82, 117, 0.10);\n  }\n\n  .learning-expect-eyebrow {\n    margin: 0 0 10px;\n    font-family: Montserrat, sans-serif;\n    font-size: 13px;\n    line-height: 1.4;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #9D654E;\n    font-weight: 600;\n  }\n\n  .learning-expect-card h2 {\n    margin: 0 0 24px;\n    font-family: 'Spectral SC', serif;\n    font-size: 38px;\n    line-height: 1.15;\n    font-weight: 300;\n    color: #2B5275;\n  }\n\n  .learning-expect-list {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .learning-expect-item {\n    display: grid;\n    grid-template-columns: 12px 1fr;\n    gap: 14px;\n    align-items: start;\n  }\n\n  .learning-expect-dot {\n    width: 8px;\n    height: 8px;\n    margin-top: 11px;\n    border-radius: 50%;\n    background-color: #6f8f7a;\n    display: block;\n  }\n\n  .learning-expect-item p {\n    margin: 0;\n    font-family: Montserrat, sans-serif;\n    font-size: 16px;\n    line-height: 1.8;\n    color: #3D2D29;\n  }\n\n  @media screen and (max-width: 600px) {\n    .learning-expect-section {\n      padding: 32px 0;\n    }\n\n    .learning-expect-card {\n      padding: 28px 24px;\n      border-radius: 20px;\n    }\n\n    .learning-expect-card h2 {\n      font-size: 31px;\n    }\n\n    .learning-expect-item p {\n      font-size: 15px;\n      line-height: 1.75;\n    }\n  }\n</style>",
