        "liquid": "<section class=\"learning-eval-section\">\n  <div class=\"learning-eval-container\">\n    <div class=\"learning-eval-intro\">\n      <p class=\"learning-eval-eyebrow\">Academic and Learning Evaluations</p>\n      <h2>Understanding learning, school performance, and the supports that may help</h2>\n      <p>\n        Academic and learning evaluations are designed to clarify patterns in reading, writing, math, attention, processing speed, executive functioning, confidence, and school performance.\n      </p>\n    </div>\n    <div class=\"learning-eval-grid\">\n      <div class=\"learning-eval-card\">\n        <h3>What this type of evaluation may help clarify</h3>\n        <p>\n          This evaluation may be appropriate when there are questions related to learning disorders, reading difficulties, dyslexia, writing challenges, math concerns, processing speed, working memory, attention, executive functioning, language-based learning needs, academic fluency, comprehension, or diagnostic clarification.\n        </p>\n        <p>\n          It may also be useful when a student appears capable but is underperforming, working much harder than peers, avoiding schoolwork, losing confidence, or struggling to keep up despite support.\n        </p>\n      </div>\n      <div class=\"learning-eval-card\">\n        <h3>Who may benefit</h3>\n        <p>\n          Children, teens, college students, and young adults may benefit from an academic and learning evaluation when there are concerns about reading, writing, math, test performance, homework completion, organization, academic confidence, school stress, or inconsistent achievement.\n        </p>\n        <p>\n          Evaluations may also be helpful for parents, schools, physicians, tutors, therapists, or other referral sources seeking diagnostic clarity and individualized recommendations.\n        </p>\n      </div>\n    </div>\n  </div>\n</section>\n<style>\n  .learning-eval-section {\n    width: 100%;\n    padding: 56px 0;\n    background: linear-gradient(135deg, #EAE2D0 0%, #ece5e1 100%);\n  }\n  .learning-eval-container {\n    max-width: 1120px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n  .learning-eval-intro {\n    max-width: 800px;\n    margin: 0 auto 34px;\n    text-align: center;\n  }\n  .learning-eval-eyebrow {\n    margin: 0 0 10px;\n    font-family: Montserrat, sans-serif;\n    font-size: 13px;\n    line-height: 1.4;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: #b89370;\n    font-weight: 600;\n  }\n  .learning-eval-intro h2 {\n    margin: 0 0 14px;\n    font-family: 'Spectral SC', serif;\n    font-size: 40px;\n    line-height: 1.16;\n    font-weight: 300;\n    color: #1d486f;\n  }\n  .learning-eval-intro p {\n    margin: 0;\n    font-family: Montserrat, sans-serif;\n    font-size: 16px;\n    line-height: 1.8;\n    color: #2B5275;\n  }\n  .learning-eval-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n  .learning-eval-card {\n    position: relative;\n    overflow: hidden;\n    background: #FFFFFF;\n    border: 1px solid rgba(29, 72, 111, 0.16);\n    border-radius: 26px;\n    padding: 38px;\n    box-shadow: 0 14px 34px rgba(29, 72, 111, 0.10);\n  }\n  .learning-eval-card::before {\n  content: \"\";\n  position: absolute;\n  top: -70px;\n  right: -70px;\n  width: 170px;\n  height: 170px;\n  border-radius: 50%;\n  background-color: #b8c9bc;\n}\n  .learning-eval-card h3 {\n    margin: 0 0 16px;\n    font-family: 'Spectral SC', serif;\n    font-size: 31px;\n    line-height: 1.18;\n    font-weight: 300;\n    color: #1d486f;\n    position: relative;\n    z-index: 1;\n  }\n  .learning-eval-card p {\n    margin: 0 0 14px;\n    font-family: Montserrat, sans-serif;\n    font-size: 16px;\n    line-height: 1.82;\n    color: #2B5275;\n    position: relative;\n    z-index: 1;\n  }\n  .learning-eval-card p:last-child {\n    margin-bottom: 0;\n  }\n  @media screen and (min-width: 850px) {\n    .learning-eval-grid {\n      grid-template-columns: repeat(2, 1fr);\n      align-items: stretch;\n    }\n  }\n  @media screen and (max-width: 700px) {\n    .learning-eval-section {\n      padding: 38px 0;\n    }\n    .learning-eval-intro h2 {\n      font-size: 31px;\n    }\n    .learning-eval-card {\n      padding: 30px 24px;\n      border-radius: 22px;\n    }\n    .learning-eval-card h3 {\n      font-size: 26px;\n    }\n    .learning-eval-card p {\n      font-size: 15px;\n      line-height: 1.75;\n    }\n  }\n</style>",
