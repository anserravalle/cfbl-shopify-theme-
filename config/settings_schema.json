  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Display / Heading Font"
      },
      {
        "type": "select",
        "id": "cfbl_font_display",
        "label": "CFBL display font",
        "options": [
          { "value": "'Cormorant SC', serif", "label": "Cormorant SC (default)" },
          { "value": "'Playfair Display', serif", "label": "Playfair Display" },
          { "value": "'DM Serif Display', serif", "label": "DM Serif Display" },
          { "value": "'Lora', serif", "label": "Lora" },
          { "value": "'Libre Baskerville', serif", "label": "Libre Baskerville" },
          { "value": "Georgia, serif", "label": "Georgia (system)" }
        ],
        "default": "'Cormorant SC', serif"
      },
      {
        "type": "select",
        "id": "inst_font_display",
        "label": "Institute display font",
        "options": [
          { "value": "'DM Serif Display', serif", "label": "DM Serif Display (default)" },
          { "value": "'Cormorant SC', serif", "label": "Cormorant SC" },
          { "value": "'Playfair Display', serif", "label": "Playfair Display" },
          { "value": "'Lora', serif", "label": "Lora" },
          { "value": "'Libre Baskerville', serif", "label": "Libre Baskerville" }
        ],
        "default": "'DM Serif Display', serif"
      },
      {
        "type": "select",
        "id": "musa_font_display",
        "label": "Publications display font",
        "options": [
          { "value": "'Playfair Display', serif", "label": "Playfair Display (default)" },
          { "value": "'Cormorant SC', serif", "label": "Cormorant SC" },
          { "value": "'DM Serif Display', serif", "label": "DM Serif Display" },
          { "value": "'Lora', serif", "label": "Lora" },
          { "value": "'EB Garamond', serif", "label": "EB Garamond" }
        ],
        "default": "'Playfair Display', serif"
      },
      {
        "type": "header",
        "content": "Body Font"
      },
      {
        "type": "select",
        "id": "font_body",
        "label": "Body / UI font (all brands)",
        "options": [
          { "value": "'Inter', system-ui, sans-serif", "label": "Inter (default)" },
          { "value": "'Lato', sans-serif", "label": "Lato" },
          { "value": "'Source Sans 3', sans-serif", "label": "Source Sans 3" },
          { "value": "'Nunito Sans', sans-serif", "label": "Nunito Sans" },
          { "value": "system-ui, sans-serif", "label": "System UI" }
        ],
        "default": "'Inter', system-ui, sans-serif"
      },
      {
        "type": "header",
        "content": "Sizes"
      },
      {
        "type": "range",
        "id": "base_font_size",
        "label": "Base body font size (px)",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "select",
        "id": "heading_weight",
        "label": "Display heading weight",
        "options": [
          { "value": "400", "label": "Regular (400)" },
